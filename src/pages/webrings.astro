---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import WebringCard from "../components/WebringCard.astro";

const description = "Little loops of the small web I'm part of.";

const webrings = (await getCollection("webrings")).sort((a, b) =>
  a.id.localeCompare(b.id),
);
---

<BaseLayout title="Webrings" description={description}>
  <PageHeader title="Webrings" description={description} showDescription />
  <section class="webrings">
    {webrings.map((entry) => <WebringCard entry={entry} />)}
  </section>
</BaseLayout>

<style>
  .webrings {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    margin-block-start: var(--space-2xl);
  }
</style>
