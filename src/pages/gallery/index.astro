---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import { COMING_SOON, STACK, getAlbums, photoName } from "../../utils/gallery";

const description =
  "Places I've wandered through, and the things I've seen and liked along the way.";

const albums = COMING_SOON ? [] : await getAlbums();
---

<BaseLayout title="Gallery" description={description}>
  <PageHeader title="Gallery" description={description} showDescription />
  {
    COMING_SOON ? (
      <div class="soon">
        <div class="soon__frames" aria-hidden="true">
          <span class="soon__frame" />
          <span class="soon__frame" />
          <span class="soon__frame" />
        </div>
        <p class="soon__note">
          <span class="soon__title">Coming soon</span>
          For when I finally start taking photos.
        </p>
      </div>
    ) : (
      <ul class="albums">
        {albums.map((album) => (
          <li>
            <a class="row" href={`/gallery/${album.id}`}>
              <span class="stack" aria-hidden="true">
                {album.photos.slice(0, STACK).map((photo, i) => (
                  <span class="card" style={`--i: ${i}`}>
                    <img
                      src={photo.thumb}
                      alt=""
                      width="160"
                      height="107"
                      transition:name={photoName(album.id, i)}
                    />
                  </span>
                ))}
              </span>
              <span class="title">{album.title}</span>
              <span class="count">{album.photos.length} photos</span>
            </a>
          </li>
        ))}
      </ul>
    )
  }
</BaseLayout>

<style>
  .albums {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .row {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    padding-block: var(--space-sm);
    border-radius: var(--radius-sm);
    color: inherit;
    text-decoration: none;
    outline: 2px solid transparent;
    outline-offset: 4px;
    transition:
      filter var(--duration-slow) var(--ease-out),
      opacity var(--duration-slow) var(--ease-out);
  }

  .row:focus-visible {
    outline-color: var(--text-subtle);
  }

  .stack {
    position: relative;
    flex-shrink: 0;
    inline-size: 2.75rem;
    block-size: 1.875rem;
  }

  .card {
    position: absolute;
    inset: 0;
    z-index: calc(3 - var(--i));
    overflow: hidden;
    border-radius: 2px;
    background: var(--background);
    box-shadow:
      0 0 0 1px var(--image-outline),
      var(--shadow-sm);
    opacity: 0;
    transition:
      rotate 600ms cubic-bezier(0.34, 1.3, 0.64, 1),
      translate 600ms cubic-bezier(0.34, 1.3, 0.64, 1),
      scale 600ms cubic-bezier(0.34, 1.3, 0.64, 1),
      opacity var(--duration-fast) var(--ease-out);
    transition-delay: calc(var(--i) * 30ms);
  }

  .card:first-child {
    opacity: 1;
  }

  .card img {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  .title {
    flex: 1;
    min-inline-size: 0;
    overflow: hidden;
    font-weight: var(--fw-heading);
    line-height: var(--lh-snug);
    color: var(--text);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .count {
    flex-shrink: 0;
    font-size: var(--fs-sm);
    font-variant-numeric: tabular-nums;
    color: var(--text-subtle);
    white-space: nowrap;
  }

  @media (hover: hover) and (pointer: fine) {
    .albums:has(.row:hover) .row:not(:hover) {
      filter: blur(3px);
      opacity: 0.35;
    }

    .row:hover .card {
      opacity: 1;
      scale: 1.3;
    }

    .row:hover .card:nth-child(1) {
      rotate: -4deg;
      translate: -2px -1px;
    }

    .row:hover .card:nth-child(2) {
      rotate: 9deg;
      translate: 7px -3px;
    }

    .row:hover .card:nth-child(3) {
      rotate: -13deg;
      translate: -9px 2px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .row,
    .card {
      transition: none;
    }
  }

  .soon {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-lg);
    margin-block-start: var(--space-2xl);
    padding: var(--space-3xl) var(--space-lg);
    border-radius: var(--radius-2xl);
    box-shadow: var(--shadow-border);
    text-align: center;
  }

  .soon__frames {
    position: relative;
    inline-size: 7rem;
    block-size: 5rem;
  }

  .soon__frame {
    --frame-pad: 4px;
    --frame-radius: calc(var(--radius-sm) + var(--frame-pad));

    position: absolute;
    inset: 0.25rem 0;
    margin: auto;
    inline-size: 6rem;
    block-size: 4.25rem;
    padding: var(--frame-pad);
    border-radius: var(--frame-radius);
    background: var(--background);
    box-shadow:
      0 0 0 1px color-mix(in oklch, var(--text) 10%, var(--background)),
      var(--shadow-xs);
    transition:
      rotate 600ms cubic-bezier(0.34, 1.3, 0.64, 1),
      translate 600ms cubic-bezier(0.34, 1.3, 0.64, 1),
      scale 600ms cubic-bezier(0.34, 1.3, 0.64, 1);
  }

  .soon__frame::after {
    content: "";
    display: block;
    block-size: 100%;
    border-radius: calc(var(--frame-radius) - var(--frame-pad));
    background: var(--surface);
  }

  .soon__frame:nth-child(1) {
    rotate: -8deg;
    translate: -0.625rem -0.125rem;
  }

  .soon__frame:nth-child(2) {
    rotate: 6deg;
    translate: 0.625rem -0.125rem;
  }

  .soon__frame:nth-child(3) {
    rotate: -1deg;
  }

  @media (hover: hover) and (pointer: fine) {
    .soon__frames:hover .soon__frame:nth-child(1) {
      rotate: -14deg;
      translate: -1.75rem 0.125rem;
    }

    .soon__frames:hover .soon__frame:nth-child(2) {
      rotate: 12deg;
      translate: 1.75rem 0.125rem;
      transition-delay: 30ms;
    }

    .soon__frames:hover .soon__frame:nth-child(3) {
      rotate: 0deg;
      translate: 0 -0.25rem;
      scale: 1.04;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .soon__frame {
      transition: none;
    }
  }

  .soon__note {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    margin: 0;
    font-size: var(--fs-sm);
    color: var(--text-muted);
  }

  .soon__title {
    font-weight: var(--fw-heading);
    color: var(--text);
  }
</style>
