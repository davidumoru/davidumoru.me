---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import PostList from "../../components/PostList.astro";
import { getPosts } from "../../utils/posts";

const description = "Posts from earlier versions of this site, and of me.";

const posts = await getPosts("archive");
---

<BaseLayout title="Archive" description={description}>
  <PageHeader title="Archive" description={description} showDescription />
  <PostList posts={posts} empty="Nothing archived yet." />
</BaseLayout>
