---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import PostList from "../../components/PostList.astro";
import { getPosts } from "../../utils/posts";

const description = "Writing on design, code, and whatever else is on my mind.";
const [drafts, live] = await Promise.all([getPosts("draft"), getPosts("live")]);
const posts = [...drafts, ...live];
---

<BaseLayout title="Posts" description={description}>
  <PageHeader title="Posts" description={description} showDescription />
  <PostList posts={posts} empty="No posts yet." />
</BaseLayout>
