---
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import RichLink from "../components/ui/RichLink.astro";
import yolatIcon from "../assets/logos/yolat.svg";
import Subscribe from "../components/Subscribe.astro";
import PlaygroundDeck from "../components/PlaygroundDeck.astro";
import Bento from "../components/bento/Bento.astro";
import BentoNow from "../components/bento/BentoNow.astro";

const pfpFiles = Object.entries(
  import.meta.glob<{ default: ImageMetadata }>(
    "../assets/pfp/*.{jpg,jpeg,png,webp}",
    { eager: true },
  ),
).sort(([a], [b]) => a.localeCompare(b));

const pfps = await Promise.all(
  pfpFiles.map(([, mod]) =>
    getImage({ src: mod.default, width: 112, height: 112 }),
  ),
);
const pfpSrcs = pfps.map((img) => img.src);
---

<BaseLayout
  title="Hello"
  description="David Umoru is a design engineer from Nigeria who obsesses over interfaces until they look, feel, and behave right."
>
  <header class="home-hero">
    <div class="home-hero-id">
      <button
        class="home-hero-pfp"
        type="button"
        aria-label="Change photo"
        data-pfps={JSON.stringify(pfpSrcs)}
      >
        <img src={pfpSrcs[0]} alt="" width="112" height="112" />
      </button>
      <div>
        <h1 class="home-hero-name">David Umoru</h1>
        <p class="home-hero-role">Design Engineer</p>
      </div>
    </div>

    <div class="home-hero-copy">
      <p>
        People have called me many things over the years, but most notably, I'm
        a designer and an engineer. A design engineer, if you will.
      </p>
      <p>
        My work mostly revolves around the web. I think a lot about how things
        look, feel, and behave, and I'll obsess over the details until the
        experience is right.
      </p>
      <p>
        At the moment, I work on the product team at{" "}
        <RichLink
          href="https://yolat.com"
          icon={yolatIcon}
          description="Yolat is a fintech startup building a simple, secure way to send, receive, and manage money across borders."
        >
          Yolat
        </RichLink>.
      </p>
    </div>
  </header>

  <div class="bento-slot">
    <BentoNow server:defer>
      <Bento slot="fallback" pending={true} />
    </BentoNow>
  </div>

  <section class="playground">
    <h2>Playground</h2>
    <p class="playground-lead">
      Visual experiments I build for fun, mostly shaders, 3D, and scroll tricks.
    </p>
    <PlaygroundDeck />
  </section>

  <div class="newsletter">
    <Subscribe />
  </div>
</BaseLayout>

<script>
  const KEY = "home-pfp";

  function bindPfp() {
    const btn = document.querySelector<HTMLButtonElement>("[data-pfps]");
    const img = btn?.querySelector("img");
    if (!btn || !img || btn.dataset.ready) return;
    btn.dataset.ready = "true";

    const srcs: string[] = JSON.parse(btn.dataset.pfps ?? "[]");
    if (!srcs.length) return;

    let i = Number.parseInt(localStorage.getItem(KEY) ?? "0", 10);
    if (!Number.isFinite(i) || i < 0) i = 0;
    i = i % srcs.length;
    img.src = srcs[i];

    btn.addEventListener("click", () => {
      i = (i + 1) % srcs.length;
      img.src = srcs[i];
      localStorage.setItem(KEY, String(i));
    });
  }

  bindPfp();
  document.addEventListener("astro:page-load", bindPfp);
</script>

<style>
  .home-hero-id {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: var(--space-md);
  }

  .home-hero-pfp {
    appearance: none;
    position: relative;
    display: block;
    flex-shrink: 0;
    width: 3rem;
    height: 3rem;
    padding: 0;
    border: none;
    background: transparent;
    border-radius: 50%;
    overflow: hidden;
    cursor: pointer;
    line-height: 0;
  }
  .home-hero-pfp img {
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
  }
  .home-hero-pfp::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px var(--image-outline);
    pointer-events: none;
  }
  .home-hero-pfp:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }
  .home-hero-pfp:active {
    transform: scale(0.96);
  }
  @media (prefers-reduced-motion: reduce) {
    .home-hero-pfp:active {
      transform: none;
    }
  }

  .home-hero-name {
    font-family: var(--font-inter), system-ui, sans-serif;
    font-size: var(--fs-base);
    font-weight: var(--fw-heading);
    line-height: var(--lh-snug);
  }

  .home-hero-role {
    margin: 0;
    color: var(--text-subtle);
  }

  .home-hero-copy {
    margin-block-start: var(--space-3xl);
  }
  .home-hero-copy p + p {
    margin-block-start: var(--space-md);
  }

  .bento-slot {
    margin-block-start: var(--space-2xl);
  }

  .playground {
    margin-block-start: var(--space-4xl);
  }
  .playground-lead {
    margin-block-start: var(--space-xs);
    margin-block-end: var(--space-xl);
  }

  .newsletter {
    margin-block-start: var(--space-5xl);
  }
</style>
