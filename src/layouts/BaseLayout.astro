---
import UnstyledBase from "./UnstyledBase.astro";
import CodeCopy from "../components/CodeCopy.astro";
import SiteNav from "../components/SiteNav.astro";
import SoundToggle from "../components/SoundToggle.astro";
import ThemeToggle from "../components/ThemeToggle.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  publishedDate?: Date;
}

const { title, description, image, type, publishedDate } = Astro.props;
---

<UnstyledBase
  title={title}
  description={description}
  image={image}
  type={type}
  publishedDate={publishedDate}
>
  <SiteNav />
  <main>
    <slot />
  </main>
  <CodeCopy />
  <div class="corner-toggles">
    <ThemeToggle />
    <SoundToggle />
  </div>
</UnstyledBase>

<style is:global>
  main {
    min-height: 100dvh;
    max-inline-size: var(--content-width);
    margin-inline: auto;
    padding-inline: var(--space-lg);
    padding-block: var(--space-5xl);
  }

  .corner-toggles {
    position: fixed;
    inset-block-end: var(--space-lg);
    inset-inline-end: var(--space-lg);
    z-index: 50;
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }
</style>
