---
import BaseLayout from "./BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import Figure from "../components/ui/Figure.astro";

interface Props {
  title: string;
  description?: string;
  showDescription?: boolean;
  date?: Date;
  dateLabel?: string;
  type?: "website" | "article";
  cover?: ImageMetadata | string;
  coverAlt?: string;
  coverTransitionName?: string;
}

const {
  title,
  description,
  showDescription = false,
  date,
  dateLabel,
  type = "website",
  cover,
  coverAlt,
  coverTransitionName,
} = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  type={type}
  publishedDate={date}
>
  <article>
    <PageHeader
      title={title}
      description={description}
      showDescription={showDescription}
      date={date}
      dateLabel={dateLabel}
    />

    {
      cover && (
        <div class="cover">
          <Figure
            src={cover}
            alt={coverAlt ?? ""}
            loading="eager"
            transitionName={coverTransitionName}
          />
        </div>
      )
    }

    <slot name="toc" />

    <div class="prose">
      <slot />
    </div>
  </article>
</BaseLayout>

<style is:global>
  .prose :is(h2, h3, h4) {
    scroll-margin-block-start: var(--space-xl);
  }
  .prose > * + *:not(hr) {
    margin-block-start: var(--space-md);
  }
  .prose > * + :is(h2, h3, h4) {
    margin-block-start: var(--space-2xl);
  }
  .prose > :is(h2, h3, h4) + *:not(hr) {
    margin-block-start: var(--space-sm);
  }
  .prose > * + :is(pre, .code-block) {
    margin-block-start: var(--space-xl);
  }
  .prose > :is(pre, .code-block) + *:not(hr, h2, h3, h4) {
    margin-block-start: var(--space-xl);
  }
</style>

<style>
  .cover {
    margin-block-end: var(--space-3xl);
  }
</style>
