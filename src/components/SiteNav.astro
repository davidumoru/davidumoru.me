---
import { Icon } from "./ui/Icon/Icon.tsx";
import {
  NAV_GROUPS,
  SOCIALS,
  isCurrent,
  normalizePath,
  resolveSection,
} from "../utils/nav";

const pathname = normalizePath(Astro.url.pathname);
const section = resolveSection(pathname);

let step = 0;
const groups = NAV_GROUPS.map((group) => ({
  label: group.label,
  labelIndex: group.label ? step++ : undefined,
  items: group.items.map((item) => ({ ...item, index: step++ })),
}));
const socialsIndex = step;
---

<header class="site-nav">
  <button
    id="siteNavTrigger"
    class="site-nav-button is-trigger"
    type="button"
    aria-label="Open menu"
    aria-controls="siteNavMenu"
    aria-expanded="false"
  >
    <svg
      class="site-nav-glyph icon size-20"
      viewBox="0 0 256 256"
      fill="currentColor"
      aria-hidden="true"
    >
      <rect
        class="site-nav-bar is-top"
        x="32"
        y="120"
        width="192"
        height="16"
        rx="8"></rect>
      <rect
        class="site-nav-bar is-bottom"
        x="32"
        y="120"
        width="192"
        height="16"
        rx="8"></rect>
    </svg>
  </button>

  {
    section && (
      <nav class="site-nav-crumbs" aria-label="Breadcrumb">
        <a class="site-nav-crumb" href="/">
          David Umoru
        </a>
        <span class="site-nav-crumb-sep" aria-hidden="true">
          /
        </span>
        <a
          class="site-nav-crumb is-section"
          href={section.href}
          aria-current={pathname === section.href ? "page" : undefined}
        >
          {section.label}
        </a>
      </nav>
    )
  }
</header>

<dialog id="siteNavMenu" class="site-nav-menu" aria-label="Site navigation">
  <div class="site-nav-menu-inner">
    <div class="site-nav-menu-bar">
      <button
        id="siteNavClose"
        class="site-nav-button"
        type="button"
        aria-label="Close menu"
      >
        <svg
          class="site-nav-glyph icon size-20"
          viewBox="0 0 256 256"
          fill="currentColor"
          aria-hidden="true"
        >
          <rect
            class="site-nav-bar is-top"
            x="32"
            y="120"
            width="192"
            height="16"
            rx="8"></rect>
          <rect
            class="site-nav-bar is-bottom"
            x="32"
            y="120"
            width="192"
            height="16"
            rx="8"></rect>
        </svg>
      </button>
    </div>

    <nav class="site-nav-groups" aria-label="Pages">
      {
        groups.map((group) => (
          <div class="site-nav-group">
            {group.label && (
              <p class="site-nav-group-label" style={`--i:${group.labelIndex}`}>
                {group.label}
              </p>
            )}
            <ul class="site-nav-list">
              {group.items.map((item) => (
                <li style={`--i:${item.index}`}>
                  <a
                    href={item.href}
                    class:list={[
                      "site-nav-link",
                      { "is-current": isCurrent(pathname, item.href) },
                    ]}
                    aria-current={
                      isCurrent(pathname, item.href) ? "page" : undefined
                    }
                  >
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </nav>

    <div class="site-nav-socials" style={`--i:${socialsIndex}`}>
      {
        SOCIALS.map(({ href, label, icon, external }) => (
          <a
            href={href}
            aria-label={label}
            {...(external
              ? { target: "_blank", rel: "me noopener noreferrer" }
              : {})}
          >
            <Icon name={icon} size={18} variant="duotone" />
          </a>
        ))
      }
    </div>
  </div>
</dialog>

<script>
  const LOCK = "nav-open";

  function bindSiteNav() {
    document.documentElement.classList.remove(LOCK);

    const trigger = document.getElementById("siteNavTrigger");
    const close = document.getElementById("siteNavClose");
    const menu = document.getElementById("siteNavMenu") as HTMLDialogElement;
    if (!trigger || !close || !menu || trigger.dataset.ready) return;
    trigger.dataset.ready = "true";

    trigger.addEventListener("click", () => {
      menu.showModal();
      trigger.setAttribute("aria-expanded", "true");
      document.documentElement.classList.add(LOCK);
    });

    close.addEventListener("click", () => menu.close());

    menu.addEventListener("close", () => {
      trigger.setAttribute("aria-expanded", "false");
      document.documentElement.classList.remove(LOCK);
    });

    menu.addEventListener("click", (event) => {
      if (event.target === menu) menu.close();
    });
  }

  bindSiteNav();
  document.addEventListener("astro:page-load", bindSiteNav);
</script>

<style is:global>
  html.nav-open {
    overflow: hidden;
  }

  .site-nav {
    --veil: 7rem;

    position: fixed;
    inset-block-start: 0;
    inset-inline: 0;
    z-index: 40;
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    block-size: 4rem;
    padding-inline: var(--space-lg);
    background: linear-gradient(
      to bottom,
      var(--background) 0%,
      color-mix(in oklch, var(--background) 96%, transparent) 24%,
      color-mix(in oklch, var(--background) 84%, transparent) 42%,
      color-mix(in oklch, var(--background) 62%, transparent) 58%,
      color-mix(in oklch, var(--background) 34%, transparent) 74%,
      color-mix(in oklch, var(--background) 12%, transparent) 88%,
      transparent 100%
    );
  }

  .site-nav::before,
  .site-nav::after {
    content: "";
    position: absolute;
    inset-block-start: 0;
    inset-inline: 0;
    block-size: var(--veil);
    z-index: -1;
    pointer-events: none;
  }

  .site-nav::before {
    backdrop-filter: blur(2px);
    mask-image: linear-gradient(
      to bottom,
      rgb(0 0 0 / 1) 0%,
      rgb(0 0 0 / 0.96) 22%,
      rgb(0 0 0 / 0.84) 38%,
      rgb(0 0 0 / 0.62) 54%,
      rgb(0 0 0 / 0.36) 70%,
      rgb(0 0 0 / 0.14) 84%,
      rgb(0 0 0 / 0.03) 94%,
      transparent 100%
    );
  }

  .site-nav::after {
    backdrop-filter: blur(7px);
    mask-image: linear-gradient(
      to bottom,
      rgb(0 0 0 / 1) 0%,
      rgb(0 0 0 / 0.92) 16%,
      rgb(0 0 0 / 0.68) 30%,
      rgb(0 0 0 / 0.38) 44%,
      rgb(0 0 0 / 0.14) 56%,
      rgb(0 0 0 / 0.02) 66%,
      transparent 72%
    );
  }

  .site-nav-button {
    display: inline-grid;
    place-items: center;
    inline-size: 2.5rem;
    block-size: 2.5rem;
    margin-inline-start: -0.625rem;
    padding: 0;
    border: none;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--text-subtle);
    cursor: pointer;
    transition:
      color var(--duration-fast) ease,
      scale var(--duration-fast) var(--ease-out);
  }

  .site-nav-button:active {
    scale: 0.96;
  }

  .site-nav-button:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }

  .site-nav-glyph {
    overflow: visible;
    transition: scale var(--duration-fast) var(--ease-out-expo);
  }

  .site-nav-bar {
    transform-box: view-box;
    transform-origin: center;
    transition:
      translate var(--duration-fast) var(--ease-out-expo),
      rotate var(--duration-fast) var(--ease-out-expo);
  }

  .site-nav-menu .site-nav-bar {
    transition-duration: var(--duration-fast);
  }

  .site-nav-bar.is-top {
    translate: 0 -32px;
  }

  .site-nav-bar.is-bottom {
    translate: 0 32px;
  }

  @media (hover: hover) and (pointer: fine) {
    .site-nav-button:hover {
      color: var(--text);
    }

    .site-nav-button:hover .site-nav-glyph {
      scale: 1.06;
    }

    .site-nav-button.is-trigger:hover .site-nav-bar.is-top {
      translate: 0 -38px;
    }

    .site-nav-button.is-trigger:hover .site-nav-bar.is-bottom {
      translate: 0 38px;
    }
  }

  .site-nav-crumbs {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    min-inline-size: 0;
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
    animation: site-nav-crumbs-in var(--duration-fast) var(--ease-out-expo) both;
  }

  @keyframes site-nav-crumbs-in {
    from {
      opacity: 0;
      translate: -0.25rem 0;
    }
  }

  .site-nav-crumb {
    color: var(--text-subtle);
    text-decoration: none;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: color var(--duration-fast) ease;
  }

  .site-nav-crumb.is-section {
    color: var(--text);
  }

  .site-nav-crumb-sep {
    color: var(--text-disabled);
  }

  .site-nav-menu {
    --stagger: 11ms;
    --enter-delay: 20ms;

    inline-size: 100%;
    max-inline-size: 100%;
    block-size: 100%;
    max-block-size: 100%;
    padding: 0;
    border: none;
    background: var(--background);
    color: var(--text);
    opacity: 0;
    transition:
      opacity var(--duration-fast) var(--ease-out),
      display var(--duration-fast) var(--ease-out) allow-discrete,
      overlay var(--duration-fast) var(--ease-out) allow-discrete;
  }

  .site-nav-menu[open] {
    opacity: 1;
    transition-duration: var(--duration-normal);
    transition-timing-function: var(--ease-out-expo);
  }

  @starting-style {
    .site-nav-menu[open] {
      opacity: 0;
    }
  }

  .site-nav-menu::backdrop {
    background: var(--background);
    opacity: 0;
    transition:
      opacity var(--duration-fast) var(--ease-out),
      display var(--duration-fast) var(--ease-out) allow-discrete,
      overlay var(--duration-fast) var(--ease-out) allow-discrete;
  }

  .site-nav-menu[open]::backdrop {
    opacity: 1;
  }

  @starting-style {
    .site-nav-menu[open]::backdrop {
      opacity: 0;
    }
  }

  .site-nav-menu[open] .site-nav-bar {
    translate: 0 0;
    transition-duration: var(--duration-fast);
  }

  .site-nav-menu[open] .site-nav-bar.is-top {
    rotate: 45deg;
  }

  .site-nav-menu[open] .site-nav-bar.is-bottom {
    rotate: -45deg;
  }

  @starting-style {
    .site-nav-menu[open] .site-nav-bar.is-top {
      translate: 0 -32px;
      rotate: 0deg;
    }

    .site-nav-menu[open] .site-nav-bar.is-bottom {
      translate: 0 32px;
      rotate: 0deg;
    }
  }

  .site-nav-menu-inner {
    display: flex;
    flex-direction: column;
    block-size: 100%;
    overflow-y: auto;
    padding-inline: var(--space-lg);
    padding-block-end: var(--space-2xl);
  }

  .site-nav-menu-bar {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    block-size: 4rem;
    margin-block-end: var(--space-xl);
  }

  .site-nav-group + .site-nav-group {
    margin-block-start: var(--space-xl);
  }

  .site-nav-group-label {
    margin-block-end: var(--space-sm);
    font-size: var(--fs-sm);
    color: var(--text-subtle);
  }

  .site-nav-list {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-nav-menu[open] .site-nav-list li,
  .site-nav-menu[open] .site-nav-socials {
    animation: site-nav-rise var(--duration-fast) var(--ease-out-expo) both;
    animation-delay: calc(var(--enter-delay) + var(--i) * var(--stagger));
  }

  .site-nav-menu[open] .site-nav-group-label {
    animation: site-nav-fade var(--duration-fast) var(--ease-out-expo) both;
    animation-delay: calc(var(--enter-delay) + var(--i) * var(--stagger));
  }

  @keyframes site-nav-rise {
    from {
      opacity: 0;
      translate: 0 0.5rem;
    }
  }

  @keyframes site-nav-fade {
    from {
      opacity: 0;
    }
  }

  .site-nav-link {
    display: inline-block;
    padding-block: var(--space-xs);
    font-size: var(--fs-2xl);
    font-weight: var(--fw-semibold);
    line-height: var(--lh-snug);
    color: var(--text-muted);
    text-decoration: none;
    transition: color var(--duration-fast) ease;
  }

  .site-nav-socials {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    margin-block-start: auto;
    padding-block-start: var(--space-2xl);
  }

  .site-nav-socials a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-inline-size: 2.5rem;
    min-block-size: 2.5rem;
    margin-inline-start: -0.6875rem;
    color: var(--text-subtle);
    text-decoration: none;
    border-radius: var(--radius-sm);
    transition:
      color var(--duration-fast) ease,
      scale var(--duration-fast) var(--ease-out);
  }

  .site-nav-socials a + a {
    margin-inline-start: 0;
  }

  .site-nav-socials a:active {
    scale: 0.96;
  }

  .site-nav-socials a:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }

  @media (max-width: 30rem) {
    .site-nav-link {
      font-size: var(--fs-xl);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-nav-menu[open] .site-nav-list li,
    .site-nav-menu[open] .site-nav-socials,
    .site-nav-menu[open] .site-nav-group-label {
      animation-name: site-nav-fade;
      animation-delay: 0ms;
    }

    .site-nav-menu[open] .site-nav-bar {
      transition-delay: 0ms;
    }

    .site-nav-button:hover .site-nav-glyph,
    .site-nav-button:active {
      scale: 1;
    }

    .site-nav-button.is-trigger:hover .site-nav-bar.is-top {
      translate: 0 -32px;
    }

    .site-nav-button.is-trigger:hover .site-nav-bar.is-bottom {
      translate: 0 32px;
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .site-nav-crumb:hover {
      color: var(--text);
    }
    .site-nav-link:hover,
    .site-nav-link.is-current {
      color: var(--text);
    }
    .site-nav-socials a:hover {
      color: var(--text);
    }
  }
</style>
