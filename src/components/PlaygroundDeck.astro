---
const href = "https://playground.davidumoru.me";
const clips = [
  "https://umorucdn.xyz/image-trail.mp4",
  "https://umorucdn.xyz/3d-photo-carousel.mp4",
  "https://umorucdn.xyz/photo-sphere.mp4",
  "https://umorucdn.xyz/path-marquee.mp4",
  "https://umorucdn.xyz/infinite-parallax-grid.mp4",
  "https://umorucdn.xyz/shader-orb.mp4",
];

const marqueeClips = [...clips, ...clips];
---

<div class="deck">
  <a
    class="frame"
    href={href}
    aria-label="Step into the playground"
    target="_blank"
    rel="noopener"
  >
    <div class="stage" style={`--n:${clips.length}`}>
      {
        clips.map((src, i) => (
          <div class="card" style={`--i:${i}`}>
            <video
              src={src}
              autoplay
              loop
              muted
              playsinline
              preload="metadata"
            />
          </div>
        ))
      }
    </div>

    <div class="marquee" aria-hidden="true">
      <div class="track">
        {
          marqueeClips.map((src) => (
            <div class="card">
              <video
                src={src}
                autoplay
                loop
                muted
                playsinline
                preload="metadata"
              />
            </div>
          ))
        }
      </div>
    </div>
  </a>
</div>

<script>
  function setup() {
    document.querySelectorAll<HTMLElement>(".deck").forEach((deck) => {
      if (deck.dataset.ready) return;
      deck.dataset.ready = "true";
      const videos = deck.querySelectorAll("video");
      const io = new IntersectionObserver(
        ([entry]) => {
          videos.forEach((v) =>
            entry.isIntersecting ? v.play().catch(() => {}) : v.pause(),
          );
        },
        { threshold: 0.1 },
      );
      io.observe(deck);
    });
  }
  setup();
  document.addEventListener("astro:page-load", setup);
</script>

<style>
  .deck {
    inline-size: 100vw;
    margin-inline: calc(50% - 50vw);
  }

  .frame {
    display: block;
    inline-size: 100%;
    max-inline-size: 1120px;
    margin-inline: auto;
    pointer-events: none;
  }

  .card {
    position: relative;
    aspect-ratio: 16 / 10;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--surface);
  }
  .card video {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    display: block;
  }
  .card::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px var(--image-outline);
    pointer-events: none;
    transition: box-shadow var(--duration-slow) var(--ease-out);
  }

  .stage {
    --gap-z: 128px;
    position: relative;
    transform-style: preserve-3d;
    transform: perspective(5000px) rotateX(-14deg) rotateY(40deg);
    block-size: 364px;
    transition: transform var(--duration-slow) var(--ease-out);
  }

  .stage:hover {
    --gap-z: 168px;
    transform: perspective(5000px) rotateX(-10deg) rotateY(32deg);
  }

  .stage .card {
    --o: calc(var(--i) - (var(--n) - 1) / 2);
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: 50%;
    inline-size: 320px;
    box-shadow: var(--shadow-xl);
    transform: translate(-50%, -50%) translateZ(calc(var(--o) * var(--gap-z)));
    pointer-events: auto;
    cursor: pointer;
    transition: transform var(--duration-slow) var(--ease-out);
  }

  .stage .card:hover {
    transform: translate(-50%, -50%) translateZ(calc(var(--o) * var(--gap-z)))
      translateY(-18px);
  }
  .stage .card:hover::after {
    box-shadow: inset 0 0 0 1px var(--border-strong);
  }

  .stage .card:hover ~ .card {
    transform: translate(-50%, -50%)
      translateZ(calc(var(--o) * var(--gap-z) + 56px));
  }

  .stage .card:active {
    transform: translate(-50%, -50%) translateZ(calc(var(--o) * var(--gap-z)))
      translateY(-18px) scale(0.98);
  }

  .marquee {
    display: none;
    overflow: hidden;
    pointer-events: auto;
    cursor: pointer;
    -webkit-mask: linear-gradient(
      90deg,
      transparent,
      #000 8%,
      #000 92%,
      transparent
    );
    mask: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .track {
    display: flex;
    inline-size: max-content;
    animation: deck-marquee 34s linear infinite;
  }
  .marquee:hover .track {
    animation-play-state: paused;
  }
  .marquee .card {
    flex: 0 0 auto;
    inline-size: 280px;
    margin-inline-end: var(--space-md);
    box-shadow: var(--shadow-lg);
  }
  @keyframes deck-marquee {
    to {
      transform: translateX(-50%);
    }
  }

  @media (max-width: 40rem) {
    .stage {
      display: none;
    }
    .marquee {
      display: block;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .track {
      animation: none;
    }
    .marquee {
      overflow-x: auto;
    }
    .stage:hover {
      --gap-z: 128px;
      transform: perspective(5000px) rotateX(-14deg) rotateY(40deg);
    }
    .stage .card:hover,
    .stage .card:hover ~ .card,
    .stage .card:active {
      transform: translate(-50%, -50%) translateZ(calc(var(--o) * var(--gap-z)));
    }
  }
</style>
