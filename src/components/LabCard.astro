---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

interface Props {
  entry: CollectionEntry<"lab">;
}

const { entry } = Astro.props;

const posters = import.meta.glob<{ default: ImageMetadata }>(
  "../content/lab/*/poster{,-dark}.png",
  { eager: true },
);
const light = posters[`../content/lab/${entry.id}/poster.png`]?.default;
const dark = posters[`../content/lab/${entry.id}/poster-dark.png`]?.default;
---

<a class="card" href={`/lab/${entry.id}`}>
  <div class="preview">
    {
      light && (
        <Image
          class:list={["poster", dark && "poster--light"]}
          src={light}
          alt=""
        />
      )
    }
    {dark && <Image class="poster poster--dark" src={dark} alt="" />}
  </div>
  <div class="reveal">
    <div class="reveal-inner">
      <p class="title">{entry.data.title}</p>
    </div>
  </div>
</a>

<style>
  .card {
    --card-pad: var(--space-sm);
    --card-radius: var(--radius-2xl);

    position: relative;
    display: flex;
    flex-direction: column;
    aspect-ratio: 3 / 2;
    padding: var(--card-pad);
    border-radius: var(--card-radius);
    box-shadow: var(--shadow-border);
    text-decoration: none;
    overflow: clip;
    transition: box-shadow var(--duration-fast) ease;
  }
  .preview {
    --inner-radius: calc(var(--card-radius) - var(--card-pad));
    --cut: calc(var(--space-sm) + var(--lh-snug) * 1em);

    flex: 1;
    min-height: 0;
    border-radius: var(--inner-radius);
    background: var(--surface);
    overflow: hidden;
    clip-path: inset(0 round var(--inner-radius));
    transition: clip-path var(--duration-fast) var(--ease-out);
  }
  .card:hover .preview,
  .card:focus-visible .preview {
    clip-path: inset(0 0 var(--cut) round var(--inner-radius));
  }
  .poster--dark,
  :global(.dark) .poster--light {
    display: none;
  }
  :global(.dark) .poster--dark {
    display: block;
  }
  .poster {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: calc(var(--card-radius) - var(--card-pad));
    box-shadow: inset 0 0 0 1px var(--image-outline);
  }
  .reveal {
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0;
    padding: 0 var(--card-pad) var(--card-pad);
    background: var(--background);
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows var(--duration-fast) var(--ease-out);
  }
  .card:hover .reveal,
  .card:focus-visible .reveal {
    grid-template-rows: 1fr;
  }
  .reveal-inner {
    overflow: hidden;
    min-height: 0;
  }
  .title {
    padding-block-start: var(--space-sm);
    padding-inline: var(--space-xs);
    line-height: var(--lh-snug);
    color: var(--text-subtle);
    opacity: 0;
    transition: opacity var(--duration-fast) var(--ease-out);
  }
  .card:hover .title,
  .card:focus-visible .title {
    opacity: 1;
  }

  @media (hover: hover) and (pointer: fine) {
    .card:hover {
      box-shadow: var(--shadow-border-hover);
    }
  }
</style>
