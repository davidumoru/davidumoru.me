---
import { Icon } from "./ui/Icon/Icon.tsx";
---

<button
  id="themeToggle"
  type="button"
  aria-label="Toggle color theme"
  data-silent
>
  <span class="when-light" data-theme-motion
    ><Icon name="sun" size={16} variant="duotone" /></span
  >
  <span class="when-dark" data-theme-motion
    ><Icon name="moon" size={16} variant="duotone" /></span
  >
</button>

<script>
  import { play } from "../utils/sound";

  function bindThemeSound() {
    const btn = document.getElementById("themeToggle");
    if (!btn || btn.dataset.soundReady) return;
    btn.dataset.soundReady = "true";
    btn.addEventListener("click", () => {
      const willBeDark = !document.documentElement.classList.contains("dark");
      play(willBeDark ? "toggle-on" : "toggle-off");
    });
  }

  bindThemeSound();
  document.addEventListener("astro:page-load", bindThemeSound);
</script>

<style>
  button {
    display: inline-grid;
    place-items: center;
    inline-size: 2.25rem;
    block-size: 2.25rem;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: var(--surface);
    box-shadow: var(--shadow-border);
    color: var(--text-subtle);
    cursor: pointer;
    transition:
      color var(--duration-fast) var(--ease-out),
      scale var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out);
  }

  button:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }

  .when-light,
  .when-dark {
    grid-area: 1 / 1;
    display: inline-flex;
    transition:
      opacity var(--duration-normal) var(--ease-out),
      scale var(--duration-normal) var(--ease-out),
      rotate var(--duration-normal) var(--ease-out);
  }

  .when-light {
    opacity: 1;
    scale: 1;
    rotate: 0deg;
  }
  .when-dark {
    opacity: 0;
    scale: 0.5;
    rotate: 90deg;
  }
  :global(.dark) .when-light {
    opacity: 0;
    scale: 0.5;
    rotate: -90deg;
  }
  :global(.dark) .when-dark {
    opacity: 1;
    scale: 1;
    rotate: 0deg;
  }

  @media (hover: hover) and (pointer: fine) {
    button:hover {
      scale: 1.08;
      color: var(--text);
      box-shadow: var(--shadow-border-hover);
    }
  }

  button:active {
    scale: 0.94;
  }
</style>
