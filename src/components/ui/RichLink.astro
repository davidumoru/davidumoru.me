---
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  href: string;
  icon?: ImageMetadata;
  title?: string;
  description?: string;
}

const { href, icon, title, description } = Astro.props;

const host = URL.canParse(href) ? new URL(href).hostname : null;

const iconImage = icon
  ? await getImage({
      src: icon,
      width: 32,
      ...(icon.format === "svg" ? { format: "svg" as const } : {}),
    })
  : undefined;
---

<a
  class="rich-link"
  href={href}
  {...host ? { target: "_blank", rel: "noopener noreferrer" } : {}}
>
  {iconImage && <img src={iconImage.src} alt="" loading="lazy" />}
  <span class="rich-link__label"><slot /></span>

  {
    (title || description) && (
      <span class="rich-link__card" aria-hidden="true">
        <span class="rich-link__card-head">
          {iconImage && <img src={iconImage.src} alt="" loading="lazy" />}
          {host}
        </span>
        {title && <span class="rich-link__card-title">{title}</span>}
        {description && <span class="rich-link__card-desc">{description}</span>}
      </span>
    )
  }
</a>

<style>
  .rich-link {
    position: relative;
    white-space: nowrap;
    text-decoration: none;
    color: var(--text);
  }

  .rich-link img {
    display: inline-block;
    inline-size: auto;
    block-size: 1.08em;
    vertical-align: -0.2em;
    margin-inline-start: 0.14em;
    margin-inline-end: 0.3em;
    border-radius: 0.2em;
    outline: 1px solid var(--image-outline);
    outline-offset: -1px;
  }

  .rich-link__label {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-decoration-skip-ink: auto;
    text-underline-offset: 0.15em;
    text-decoration-color: var(--border-strong);
    transition: text-decoration-color var(--duration-fast) ease;
  }

  .rich-link__card {
    position: absolute;
    inset-block-end: calc(100% + var(--space-sm));
    inset-inline-start: 0;
    z-index: 20;
    display: grid;
    inline-size: max-content;
    max-inline-size: 18rem;
    padding: var(--space-sm);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow-border), var(--shadow-lg);
    font-weight: var(--fw-regular);
    white-space: normal;
    text-wrap: pretty;
    opacity: 0;
    visibility: hidden;
    scale: 0.97;
    translate: 0 0.25rem;
    transition:
      opacity var(--duration-fast) var(--ease-out),
      scale var(--duration-fast) var(--ease-out),
      translate var(--duration-fast) var(--ease-out),
      visibility var(--duration-fast);
  }

  .rich-link__card::after {
    content: "";
    position: absolute;
    inset-inline: 0;
    inset-block-start: 100%;
    block-size: var(--space-sm);
  }

  .rich-link:is(:hover, :focus-visible) .rich-link__card {
    opacity: 1;
    visibility: visible;
    scale: 1;
    translate: 0 0;
  }

  @media (hover: none) {
    .rich-link__card {
      display: none;
    }
  }

  .rich-link__card-head {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    font-size: var(--fs-xs);
    color: var(--text-subtle);
  }

  .rich-link__card-head img {
    block-size: 14px;
    vertical-align: baseline;
    margin: 0;
  }

  .rich-link__card-title {
    margin-block-start: var(--space-sm);
    font-size: var(--fs-sm);
    line-height: var(--lh-snug);
    color: var(--text);
  }

  .rich-link__card-desc {
    margin-block-start: var(--space-xs);
    font-size: var(--fs-sm);
    line-height: var(--lh-snug);
    color: var(--text-muted);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .rich-link__card-head + .rich-link__card-desc {
    margin-block-start: var(--space-sm);
  }

  @media (prefers-reduced-motion: reduce) {
    .rich-link__card {
      scale: 1;
      translate: none;
    }
  }

  @media (hover: hover) and (pointer: fine) {
    a.rich-link:hover {
      color: var(--text);
    }
    .rich-link:hover .rich-link__label {
      text-decoration-color: var(--text);
    }
  }
</style>
