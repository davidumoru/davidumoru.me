---
import { Code } from "astro:components";
import { Icon } from "../ui/Icon/Icon.tsx";

interface Props {
  name: string;
}

const { name } = Astro.props;

const tsx = import.meta.glob("./*/*.tsx", {
  query: "?raw",
  import: "default",
  eager: true,
}) as Record<string, string>;

const css = import.meta.glob("./*/*.module.css", {
  query: "?raw",
  import: "default",
  eager: true,
}) as Record<string, string>;

const files = [
  { name: `${name}.tsx`, lang: "tsx", code: tsx[`./${name}/${name}.tsx`] },
  {
    name: `${name}.module.css`,
    lang: "css",
    code: css[`./${name}/${name}.module.css`],
  },
].filter((file): file is { name: string; lang: "tsx" | "css"; code: string } =>
  Boolean(file.code),
);
---

<div class="demo">
  <div class="stage">
    <slot />
  </div>
  {
    files.length > 0 && (
      <details class="source" data-silent>
        <summary>
          <Icon name="chevronRight" size={16} className="chevron" />
          <span>View source</span>
        </summary>
        <div class="files">
          {files.map((file) => (
            <div class="file">
              <span class="filename">{file.name}</span>
              <Code
                code={file.code.trim()}
                lang={file.lang}
                themes={{ light: "github-light", dark: "github-dark" }}
              />
            </div>
          ))}
        </div>
      </details>
    )
  }
</div>

<script>
  import { play } from "../../utils/sound";

  function setup() {
    document
      .querySelectorAll<HTMLDetailsElement>("details.source")
      .forEach((details) => {
        if (details.dataset.ready) return;
        details.dataset.ready = "true";
        details.addEventListener("toggle", () => {
          play(details.open ? "expand" : "collapse");
        });
      });
  }

  setup();
  document.addEventListener("astro:page-load", setup);
</script>

<style>
  .stage {
    display: grid;
    min-height: 28rem;
    border-radius: var(--radius-xl);
    background: var(--surface);
    box-shadow: var(--shadow-border);
    overflow: hidden;
  }
  .source {
    margin-block-start: var(--space-md);
  }
  .source summary {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    padding-block: var(--space-xs);
    padding-inline: var(--space-xs) var(--space-sm);
    border-radius: var(--radius-md);
    color: var(--text-subtle);
    font-size: var(--fs-sm);
    cursor: pointer;
    user-select: none;
    list-style: none;
    transition:
      color var(--duration-fast) ease,
      background var(--duration-fast) ease;
  }
  .source summary::-webkit-details-marker {
    display: none;
  }
  .source summary:hover {
    color: var(--text);
    background: var(--surface);
  }
  .source :global(.chevron) {
    transition: transform var(--duration-fast) ease;
  }
  .source[open] :global(.chevron) {
    transform: rotate(90deg);
  }
  .source::details-content {
    block-size: 0;
    overflow: clip;
    overflow-clip-margin: var(--space-sm);
    transition:
      block-size var(--duration-normal) var(--ease-out),
      content-visibility var(--duration-normal) allow-discrete;
  }
  .source[open]::details-content {
    block-size: auto;
  }
  .files {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-md);
    margin-block-start: var(--space-sm);
  }
  .filename {
    display: block;
    margin-block-end: var(--space-xs);
    font-family: var(--font-geist-mono), monospace;
    font-size: var(--fs-sm);
    color: var(--text-subtle);
  }
</style>
