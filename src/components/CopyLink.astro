---
import { Icon } from "./ui/Icon/Icon.tsx";
---

<button
  class="copy"
  type="button"
  aria-label="Copy link to this page"
  data-copy-url
  data-silent
>
  <span class="slot link"><Icon name="link" size={16} /></span>
  <span class="slot check"><Icon name="check" size={16} /></span>
</button>

<script>
  import { play } from "../utils/sound";

  function init(btn: HTMLButtonElement) {
    if (btn.dataset.ready) return;
    btn.dataset.ready = "true";

    btn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(window.location.href);
        play("copy");
        btn.classList.add("copied");
        window.setTimeout(() => btn.classList.remove("copied"), 1500);
      } catch {}
    });
  }

  function setup() {
    document
      .querySelectorAll<HTMLButtonElement>("[data-copy-url]")
      .forEach(init);
  }

  setup();
  document.addEventListener("astro:page-load", setup);
</script>

<style>
  .copy {
    display: inline-grid;
    place-items: center;
    inline-size: var(--space-xl);
    block-size: var(--space-xl);
    padding: 0;
    border: none;
    border-radius: var(--radius-md);
    background: transparent;
    color: var(--text-subtle);
    cursor: pointer;
    transition:
      color var(--duration-fast) ease,
      background var(--duration-fast) ease;
  }
  .copy:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }
  .slot {
    grid-area: 1 / 1;
    display: inline-flex;
    transition:
      opacity var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out),
      filter var(--duration-fast) var(--ease-out);
  }
  .check {
    opacity: 0;
    transform: scale(0.25);
    filter: blur(4px);
  }
  .copy.copied .link {
    opacity: 0;
    transform: scale(0.25);
    filter: blur(4px);
  }
  .copy.copied .check {
    opacity: 1;
    transform: scale(1);
    filter: blur(0);
  }

  @media (hover: hover) and (pointer: fine) {
    .copy:hover {
      color: var(--text);
      background: var(--surface);
    }
  }
</style>
