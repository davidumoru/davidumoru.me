---
import { Image } from "astro:assets";
import interstellar from "../../assets/film-posters/interstellar.png";
import hacksawRidge from "../../assets/film-posters/hacksaw-ridge.png";
import pursuitOfHappyness from "../../assets/film-posters/the-pursuit-of-happyness.png";
import perksOfBeingAWallflower from "../../assets/film-posters/the-perks-of-being-a-wallflower.png";

const films = [
  {
    title: "Interstellar",
    url: "https://letterboxd.com/film/interstellar/",
    poster: interstellar,
  },
  {
    title: "Hacksaw Ridge",
    url: "https://letterboxd.com/film/hacksaw-ridge/",
    poster: hacksawRidge,
  },
  {
    title: "The Pursuit of Happyness",
    url: "https://letterboxd.com/film/the-pursuit-of-happyness/",
    poster: pursuitOfHappyness,
  },
  {
    title: "The Perks of Being a Wallflower",
    url: "https://letterboxd.com/film/the-perks-of-being-a-wallflower/",
    poster: perksOfBeingAWallflower,
  },
];
---

<div class="top-four">
  {
    films.map((f) => (
      <a
        class="top-four__item"
        href={f.url}
        target="_blank"
        rel="noopener"
        aria-label={f.title}
      >
        <span class="top-four__poster">
          <Image
            src={f.poster}
            alt={`${f.title} poster`}
            widths={[318, 635]}
            sizes="(max-width: 34rem) 22vw, 148px"
            loading="lazy"
          />
        </span>
      </a>
    ))
  }
</div>

<style>
  .top-four {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-md);
    align-items: start;
  }

  .top-four__item {
    display: block;
    text-decoration: none;
  }

  .top-four__poster {
    display: block;
    aspect-ratio: 635 / 900;
    border-radius: var(--radius-sm);
    overflow: hidden;
    background: var(--surface);
    box-shadow:
      0 0 0 2px transparent,
      var(--shadow-sm),
      inset 0 0 0 1px var(--image-outline);
    transition: box-shadow var(--duration-fast) var(--ease-out);
  }
  .top-four__item:hover .top-four__poster,
  .top-four__item:focus-visible .top-four__poster {
    box-shadow:
      0 0 0 2px var(--primary),
      var(--shadow-sm),
      inset 0 0 0 1px var(--image-outline);
  }
  .top-four__poster img {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    display: block;
  }

  @media (max-width: 34rem) {
    .top-four {
      gap: var(--space-sm);
    }
  }
</style>
