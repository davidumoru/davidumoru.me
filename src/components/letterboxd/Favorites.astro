---
const films = [
  {
    title: "Interstellar",
    url: "https://letterboxd.com/film/interstellar/",
    poster:
      "https://a.ltrbxd.com/resized/film-poster/1/1/7/6/2/1/117621-interstellar-0-600-0-900-crop.jpg",
  },
  {
    title: "Hacksaw Ridge",
    url: "https://letterboxd.com/film/hacksaw-ridge/",
    poster:
      "https://a.ltrbxd.com/resized/film-poster/2/5/1/8/7/2/251872-hacksaw-ridge-0-600-0-900-crop.jpg",
  },
  {
    title: "The Pursuit of Happyness",
    url: "https://letterboxd.com/film/the-pursuit-of-happyness/",
    poster:
      "https://a.ltrbxd.com/resized/film-poster/5/1/0/6/1/51061-the-pursuit-of-happyness-0-600-0-900-crop.jpg",
  },
  {
    title: "The Perks of Being a Wallflower",
    url: "https://letterboxd.com/film/the-perks-of-being-a-wallflower/",
    poster:
      "https://a.ltrbxd.com/resized/film-poster/7/1/3/3/8/71338-the-perks-of-being-a-wallflower-0-600-0-900-crop.jpg",
  },
];
---

<div class="letterboxd-favorites">
  {
    films.map((f) => (
      <a
        class="letterboxd-favorites__item"
        href={f.url}
        target="_blank"
        rel="noopener"
        aria-label={f.title}
      >
        <span class="letterboxd-favorites__poster">
          <img
            src={f.poster}
            alt={`${f.title} poster`}
            loading="lazy"
            width="600"
            height="900"
          />
        </span>
      </a>
    ))
  }
</div>

<style>
  .letterboxd-favorites {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-md);
    align-items: start;
  }

  .letterboxd-favorites__item {
    display: block;
    text-decoration: none;
  }

  .letterboxd-favorites__poster {
    display: block;
    aspect-ratio: 2 / 3;
    border-radius: var(--radius-sm);
    overflow: hidden;
    background: var(--surface);
    box-shadow:
      0 0 0 2px transparent,
      var(--shadow-sm),
      inset 0 0 0 1px var(--image-outline);
    transition: box-shadow var(--duration-fast) var(--ease-out);
  }
  .letterboxd-favorites__item:hover .letterboxd-favorites__poster,
  .letterboxd-favorites__item:focus-visible .letterboxd-favorites__poster {
    box-shadow:
      0 0 0 2px var(--primary),
      var(--shadow-sm),
      inset 0 0 0 1px var(--image-outline);
  }
  .letterboxd-favorites__poster img {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    display: block;
  }

  @media (max-width: 34rem) {
    .letterboxd-favorites {
      gap: var(--space-sm);
    }
  }
</style>
