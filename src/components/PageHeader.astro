---
import { formatDate, toISODate } from "../utils/date";

interface Props {
  title: string;
  description?: string;
  showDescription?: boolean;
  date?: Date;
  dateLabel?: string;
}

const {
  title,
  description,
  showDescription = false,
  date,
  dateLabel,
} = Astro.props;

const dateDisplay = date ? formatDate(date) : undefined;
const dateISO = date ? toISODate(date) : undefined;
---

<header class="page-header">
  <slot name="eyebrow" />
  <h1>{title}</h1>
  {showDescription && description && <p class="lead">{description}</p>}
  {
    (dateDisplay || Astro.slots.has("meta-end")) && (
      <p class="meta">
        <span class="meta-date">
          {dateDisplay && (
            <Fragment>
              {dateLabel ? `${dateLabel} ` : ""}
              <time datetime={dateISO}>{dateDisplay}</time>
            </Fragment>
          )}
        </span>
        <slot name="meta-end" />
      </p>
    )
  }
  <slot />
</header>

<style>
  .page-header {
    margin-block-end: var(--space-xl);
  }
  .lead {
    margin-block-start: var(--space-md);
    font-size: 1.4rem;
    color: var(--text);
    max-width: 34rem;
    line-height: var(--lh-tight);
  }
  .meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    margin-block-start: var(--space-sm);
    color: var(--text-subtle);
  }
</style>
