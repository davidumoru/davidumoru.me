---
import type { Track } from "../../utils/spotify";
import { formatListeningStatus } from "../../utils/date";

interface Props {
  track?: Track | null;
  pending?: boolean;
}

const { track, pending = false } = Astro.props;
const status = track ? formatListeningStatus(track) : null;
---

<div
  class="now-playing"
  data-live={track?.live ?? false}
  data-pending={pending ? true : undefined}
  aria-busy={pending ? true : undefined}
  hidden={!pending && !track}
>
  <div class="now-playing__card">
    <span class="now-playing__vinyl" aria-hidden="true">
      <span class="now-playing__disc">
        {
          track?.cover && (
            <img
              src={track.cover}
              alt=""
              width="96"
              height="96"
              decoding="async"
            />
          )
        }
      </span>
      <span class="now-playing__sheen"></span>
      <span class="now-playing__spindle"></span>
    </span>

    <span class="now-playing__meta">
      {
        track?.url ? (
          <a
            class="now-playing__title"
            href={track.url}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${track.title} by ${track.artist}`}
          >
            {track.title}
          </a>
        ) : (
          <span
            class:list={["now-playing__title", pending && "now-playing__bone"]}
          >
            {track?.title}
          </span>
        )
      }
      <span
        class:list={["now-playing__artist", pending && "now-playing__bone"]}
      >
        {track?.artist}
      </span>
    </span>
  </div>

  <p class="now-playing__status">
    <span class="now-playing__dot" aria-hidden="true"></span>
    <span class="now-playing__status-text">{status}</span>
    {pending && <span class="now-playing__bone now-playing__status-bone" />}
  </p>
  {
    pending && (
      <p class="sr-only" role="status">
        Loading now playing
      </p>
    )
  }
</div>

<style>
  .now-playing {
    --np-card-h: 5rem;
    --np-disc: calc(var(--np-card-h) * 1.375);
    --np-disc-x: calc(var(--np-card-h) * 0.275);
    --np-text-x: calc(var(--np-card-h) * 1.2);
    --np-pad: 0.375rem;
    --np-tray: var(--surface-hover);
    --np-card: var(--background);
    --np-bone: var(--gray-5);
    --np-bone-shine: var(--gray-7);
    --np-label-bone: oklch(0.32 0 0);
    --np-label-shine: oklch(0.42 0 0);

    padding: var(--np-pad);
    border-radius: calc(var(--radius-md) + var(--np-pad));
    background: var(--np-tray);
    box-shadow: var(--shadow-sm);
  }

  :global(.dark) .now-playing {
    --np-tray: var(--surface);
    --np-card: var(--surface-hover);
  }

  @media (max-width: 30rem) {
    .now-playing {
      --np-card-h: 4.25rem;
    }
  }

  .now-playing__card {
    position: relative;
    display: flex;
    align-items: center;
    block-size: var(--np-card-h);
    padding-inline: var(--np-text-x) var(--space-md);
    overflow: hidden;
    border-radius: var(--radius-md);
    background: var(--np-card);
    box-shadow: var(--shadow-border);
  }

  .now-playing__vinyl {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: calc(var(--np-disc-x) - var(--np-disc) / 2);
    inline-size: var(--np-disc);
    block-size: var(--np-disc);
    translate: 0 -50%;
    pointer-events: none;
    transition: translate var(--duration-normal) var(--ease-out);
  }

  .now-playing__card:has(a.now-playing__title:is(:hover, :focus-visible))
    .now-playing__vinyl {
    translate: 0.1875rem -50%;
  }

  .now-playing__disc {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background:
      repeating-radial-gradient(
        circle at center,
        transparent 0 3px,
        oklch(1 0 0 / 0.07) 3px 4px
      ),
      radial-gradient(
        circle at center,
        oklch(0.11 0 0) 40%,
        oklch(0.16 0 0) 100%
      );
    box-shadow: inset 0 0 0 1px oklch(1 0 0 / 0.12);
  }

  .now-playing__disc img,
  .now-playing__disc:has(img)::after,
  .now-playing[data-pending] .now-playing__disc::before {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: 50%;
    inline-size: 44%;
    block-size: 44%;
    translate: -50% -50%;
    border-radius: 50%;
  }
  .now-playing__disc img {
    object-fit: cover;
  }
  .now-playing__disc:has(img)::after {
    content: "";
    box-shadow: inset 0 0 0 1px oklch(1 0 0 / 0.1);
  }
  .now-playing[data-pending] .now-playing__spindle {
    display: none;
  }

  .now-playing__sheen {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: conic-gradient(
      from 55deg,
      transparent 0deg,
      oklch(1 0 0 / 0.13) 30deg,
      transparent 70deg,
      transparent 180deg,
      oklch(1 0 0 / 0.13) 210deg,
      transparent 250deg
    );
  }

  .now-playing__spindle {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: 50%;
    inline-size: 6%;
    block-size: 6%;
    translate: -50% -50%;
    border-radius: 50%;
    background: oklch(0 0 0 / 0.2);
    box-shadow: inset 0 0 0 1px oklch(0.15 0 0 / 0.8);
  }

  .now-playing[data-live="true"] .now-playing__disc {
    animation: now-playing-spin 8s linear infinite;
  }

  @keyframes now-playing-spin {
    to {
      rotate: 1turn;
    }
  }

  .now-playing__meta {
    display: grid;
    min-inline-size: 0;
  }
  .now-playing__title,
  .now-playing__artist {
    justify-self: start;
    max-inline-size: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .now-playing__title {
    font-size: var(--fs-base);
    font-weight: var(--fw-semibold);
    line-height: var(--lh-snug);
    color: var(--text);
  }
  /* keeps the tap target at 24px without moving the artist line */
  a.now-playing__title {
    padding-block: 2px;
    margin-block: -2px;
  }
  a.now-playing__title:hover {
    color: var(--text);
    text-decoration-color: var(--text-subtle);
  }
  .now-playing__artist {
    margin-block-start: var(--space-xs);
    font-size: var(--fs-sm);
    line-height: var(--lh-snug);
    color: var(--text-muted);
  }

  .now-playing[data-pending] {
    pointer-events: none;
  }
  .now-playing__bone {
    --np-fill: var(--np-bone);
    --np-shine: var(--np-bone-shine);
    display: block;
    block-size: 0.75em;
    border-radius: var(--radius-sm);
  }
  .now-playing__title.now-playing__bone {
    inline-size: 11ch;
  }
  .now-playing__artist.now-playing__bone {
    inline-size: 8ch;
  }
  .now-playing__status-bone {
    inline-size: 9ch;
    block-size: 0.7em;
  }
  .now-playing[data-pending] .now-playing__disc::before {
    content: "";
    --np-fill: var(--np-label-bone);
    --np-shine: var(--np-label-shine);
  }
  .now-playing__bone,
  .now-playing[data-pending] .now-playing__disc::before {
    background-color: var(--np-fill);
    background-image: linear-gradient(
      100deg,
      transparent 40%,
      var(--np-shine) 50%,
      transparent 60%
    );
    background-size: 300% 100%;
    animation: now-playing-sweep 1.6s ease-in-out infinite;
  }

  @keyframes now-playing-sweep {
    from {
      background-position: 150% 0;
    }
    to {
      background-position: -50% 0;
    }
  }

  .now-playing__status {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin: 0;
    min-block-size: 1lh;
    padding-block-start: var(--np-pad);
    padding-inline-start: var(--space-xs);
    font-size: var(--fs-xs);
    color: var(--text-muted);
  }

  .now-playing__dot {
    position: relative;
    flex-shrink: 0;
    inline-size: 0.5rem;
    block-size: 0.5rem;
    border-radius: 50%;
    background: var(--primary);
    box-shadow: 0 0 0 3px color-mix(in oklch, var(--primary) 18%, transparent);
  }
  .now-playing[data-live="true"] .now-playing__dot::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--primary);
    animation: now-playing-pulse 2s var(--ease-out) infinite;
  }
  .now-playing[data-live="false"] .now-playing__dot {
    inline-size: 0.625rem;
    block-size: 0.625rem;
    background: var(--text-disabled);
    box-shadow: none;
  }

  @keyframes now-playing-pulse {
    from {
      scale: 1;
      opacity: 0.5;
    }
    to {
      scale: 2.6;
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .now-playing[data-live="true"] .now-playing__disc,
    .now-playing[data-live="true"] .now-playing__dot::after,
    .now-playing__bone,
    .now-playing[data-pending] .now-playing__disc::before {
      animation: none;
    }
    .now-playing__card:has(a.now-playing__title:is(:hover, :focus-visible))
      .now-playing__vinyl {
      translate: 0 -50%;
    }
  }
</style>

<script>
  import { formatListeningStatus } from "../../utils/date";

  type Track = {
    title: string;
    artist: string;
    cover?: string;
    url?: string;
    live: boolean;
    playedAt?: string;
  };

  const INTERVAL = 30_000;

  let timer = 0;
  let onVis: (() => void) | undefined;

  function setTitle(widget: HTMLElement, track: Track) {
    const current = widget.querySelector(".now-playing__title");
    if (!current) return;

    const wantLink = Boolean(track.url);
    const isLink = current.tagName === "A";
    const el =
      wantLink === isLink
        ? current
        : Object.assign(document.createElement(wantLink ? "a" : "span"), {
            className: current.className,
          });
    if (el !== current) current.replaceWith(el);

    el.textContent = track.title;

    if (el instanceof HTMLAnchorElement && track.url) {
      el.href = track.url;
      el.target = "_blank";
      el.rel = "noopener noreferrer";
      el.setAttribute("aria-label", `${track.title} by ${track.artist}`);
    }
  }

  function apply(slot: Element, track: Track | null) {
    const widget = slot.querySelector(".now-playing");
    if (!(widget instanceof HTMLElement)) return;

    if (!track) {
      widget.hidden = true;
      return;
    }

    widget.hidden = false;
    widget.dataset.live = String(track.live);

    const disc = widget.querySelector(".now-playing__disc");
    let img = disc?.querySelector("img");
    if (track.cover) {
      if (!img && disc) {
        img = document.createElement("img");
        img.alt = "";
        img.width = 96;
        img.height = 96;
        img.decoding = "async";
        disc.prepend(img);
      }
      if (img && img.getAttribute("src") !== track.cover) img.src = track.cover;
    } else {
      img?.remove();
    }

    setTitle(widget, track);

    const artist = widget.querySelector(".now-playing__artist");
    if (artist) artist.textContent = track.artist;

    const text = widget.querySelector(".now-playing__status-text");
    if (text) text.textContent = formatListeningStatus(track);
  }

  async function refresh(slot: Element) {
    if (document.hidden) return;
    if (slot.querySelector("[data-pending]")) return;

    try {
      const res = await fetch("/api/now-playing");
      if (!res.ok) return;
      apply(slot, (await res.json()) as Track | null);
    } catch {}
  }

  function bind() {
    clearInterval(timer);
    if (onVis) document.removeEventListener("visibilitychange", onVis);

    const slot = document.querySelector(".now-playing-slot");
    if (!slot) return;

    const tick = () => void refresh(slot);
    onVis = tick;
    timer = window.setInterval(tick, INTERVAL);
    document.addEventListener("visibilitychange", onVis);
  }

  document.addEventListener("astro:page-load", bind);
</script>
