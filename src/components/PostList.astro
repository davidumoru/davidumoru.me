---
import type { CollectionEntry } from "astro:content";
import { formatDate, toISODate } from "../utils/date";

interface Props {
  posts: CollectionEntry<"posts">[];
  empty?: string;
}

const { posts, empty = "Nothing here yet." } = Astro.props;
---

{
  posts.length > 0 ? (
    <ul class="posts">
      {posts.map((post) => {
        const draft = post.data.status === "draft";
        const Row = draft ? "div" : "a";
        return (
          <li>
            <Row
              class:list={["post", draft && "is-draft"]}
              {...(draft ? {} : { href: `/posts/${post.id}` })}
            >
              <span class="head">
                <span class="title">{post.data.title}</span>
                {draft && <span class="pill">Draft</span>}
              </span>
              <span class="meta">
                {draft ? (
                  <span class="date">&mdash;</span>
                ) : (
                  <time class="date" datetime={toISODate(post.data.date)}>
                    {formatDate(post.data.date)}
                  </time>
                )}
              </span>
            </Row>
          </li>
        );
      })}
    </ul>
  ) : (
    <p class="empty">{empty}</p>
  )
}

<style>
  .posts {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .post {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-md);
    padding: var(--space-md);
    margin-inline: calc(-1 * var(--space-md));
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition: background var(--duration-fast) var(--ease-out);
  }

  .head {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    min-inline-size: 0;
  }

  .title {
    font-size: var(--fs-lg);
    font-weight: var(--fw-heading);
    line-height: var(--lh-snug);
    color: var(--text);
    text-wrap: balance;
  }

  .pill {
    flex-shrink: 0;
    padding: 0.15em 0.5em;
    border-radius: 999px;
    box-shadow: var(--shadow-border);
    font-size: var(--fs-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-subtle);
  }

  .meta {
    flex-shrink: 0;
    display: flex;
    align-items: baseline;
    gap: var(--space-lg);
    font-size: var(--fs-sm);
    color: var(--text-subtle);
  }

  .date {
    min-inline-size: 3rem;
    text-align: end;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .is-draft {
    cursor: not-allowed;
  }
  .is-draft .title {
    color: var(--text-subtle);
  }
  .is-draft .date {
    color: var(--text-disabled);
  }

  .empty {
    color: var(--text-subtle);
  }

  @media (max-width: 34rem) {
    .post {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-xs);
    }
    .meta {
      gap: var(--space-md);
    }
    .date {
      min-inline-size: 0;
      text-align: start;
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .post:hover {
      background: var(--surface);
    }
    .is-draft:hover {
      background: color-mix(in oklch, var(--surface) 45%, transparent);
    }
  }
</style>
