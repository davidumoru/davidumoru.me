---
import { Image } from "astro:assets";
import type { WorkProject } from "../content.config";
import { Icon } from "./ui/Icon/Icon.tsx";

interface Props {
  entry: WorkProject;
}

const { entry } = Astro.props;
const { title, year, description, url, caseStudy, cover, coverAlt } =
  entry.data;

const isExternal = url?.startsWith("http") ?? false;
const liveAttrs = isExternal ? { target: "_blank", rel: "noopener" } : {};

const caseStudyHref = caseStudy ? `/work/${entry.id}` : undefined;
const coverTransition = caseStudyHref ? `work-cover-${entry.id}` : undefined;

const primary = caseStudyHref ?? url;
const primaryExternal = primary?.startsWith("http") ?? false;
const primaryAttrs = primaryExternal
  ? { target: "_blank", rel: "noopener" }
  : {};

const CoverTag = primary ? "a" : "div";
const coverAttrs = primary ? { href: primary, ...primaryAttrs } : {};
---

<article>
  <CoverTag class="cover" {...coverAttrs}>
    {
      cover ? (
        typeof cover === "string" ? (
          <img
            class="media"
            src={cover}
            alt={coverAlt ?? ""}
            loading="lazy"
            decoding="async"
            style={
              coverTransition
                ? `view-transition-name: ${coverTransition}`
                : undefined
            }
          />
        ) : (
          <Image
            class="media"
            src={cover}
            alt={coverAlt ?? ""}
            style={
              coverTransition
                ? `view-transition-name: ${coverTransition}`
                : undefined
            }
          />
        )
      ) : (
        <span class="placeholder" />
      )
    }
  </CoverTag>

  <div class="meta">
    <div class="head">
      <h2 class="title">{title}</h2>
      <span class="year">{year}</span>
    </div>
    <p class="desc">{description}</p>

    <div class="actions">
      {
        caseStudyHref ? (
          <a class="action" href={caseStudyHref}>
            Read Case Study
            <Icon name="arrowRight" size={16} />
          </a>
        ) : (
          <span class="action action--locked">
            <Icon name="lock" size={16} />
            Read Case Study
          </span>
        )
      }
      {
        url && (
          <>
            <span class="divider" aria-hidden="true" />
            <a class="action" href={url} {...liveAttrs}>
              View Live Site
              <Icon name="arrowUpRight" size={16} />
            </a>
          </>
        )
      }
    </div>
  </div>
</article>

<style>
  .cover {
    position: relative;
    display: block;
    aspect-ratio: 16 / 10;
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: inset 0 0 0 1px var(--image-outline);
  }

  .media,
  .placeholder {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    transition: transform var(--duration-slow) var(--ease-out);
  }

  .placeholder {
    background: var(--surface);
  }

  a.cover:hover .media,
  a.cover:hover .placeholder {
    transform: scale(1.03);
  }

  .meta {
    margin-block-start: var(--space-md);
  }

  .head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-md);
  }

  .title {
    font-family: var(--font-inter);
    font-size: var(--fs-lg);
    font-weight: var(--fw-medium);
    line-height: var(--lh-snug);
  }

  .year {
    flex-shrink: 0;
    font-size: var(--fs-sm);
    font-variant-numeric: tabular-nums;
    color: var(--text-subtle);
  }

  .desc {
    margin-block-start: var(--space-sm);
    color: var(--text-muted);
    text-wrap: pretty;
  }

  .actions {
    margin-block-start: var(--space-md);
    display: flex;
    align-items: center;
    gap: var(--space-md);
  }

  .action {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    font-size: var(--fs-sm);
    color: var(--text-muted);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .action--locked {
    color: var(--text-subtle);
    cursor: not-allowed;
  }

  a.action:hover,
  a.action:focus-visible {
    color: var(--text);
  }

  .divider {
    inline-size: 1px;
    block-size: 1rem;
    background: var(--border-strong);
  }
</style>
