---
import worldCountries from "world-atlas/countries-110m.json";
import worldCountriesDetailed from "world-atlas/countries-50m.json";
import { geoNaturalEarth1, geoPath } from "d3-geo";
import { feature } from "topojson-client";
import type { Feature, FeatureCollection } from "geojson";
import type { GeometryCollection, Topology } from "topojson-specification";
import iso from "iso-3166-1";
import { visitedCountryCodes } from "../data/visited-countries";
import { countryNameFromId, isUnMemberState } from "../data/un-member-states";

const visitedNumericIds = new Set(
  visitedCountryCodes
    .map((code) => iso.whereAlpha2(code)?.numeric)
    .filter((id): id is string => Boolean(id)),
);

function unMemberFeaturesFrom(atlas: unknown) {
  const topology = atlas as Topology;
  const featureCollection = feature(
    topology,
    topology.objects.countries as GeometryCollection,
  ) as FeatureCollection;
  return featureCollection.features.filter((geoFeature) =>
    isUnMemberState(String(geoFeature.id ?? "")),
  );
}

// 110m omits microstates and small island nations
const baseFeatures = unMemberFeaturesFrom(worldCountries);
const baseIds = new Set(
  baseFeatures.map((geoFeature) => String(geoFeature.id)),
);
const smallStateFeatures = unMemberFeaturesFrom(worldCountriesDetailed).filter(
  (geoFeature) => !baseIds.has(String(geoFeature.id)),
);
const unMemberFeatures = [...baseFeatures, ...smallStateFeatures];

const MAP_WIDTH = 960;
const MAP_HEIGHT = 500;

const projection = geoNaturalEarth1().fitSize([MAP_WIDTH, MAP_HEIGHT], {
  type: "FeatureCollection",
  features: unMemberFeatures,
});
const path = geoPath(projection).digits(1);

const countryFeatures = unMemberFeatures.map((geoFeature: Feature) => {
  const id = String(geoFeature.id ?? "");
  const visited = visitedNumericIds.has(id);
  const name = countryNameFromId(id, geoFeature.properties?.name);

  return {
    ...geoFeature,
    properties: {
      ...geoFeature.properties,
      name,
      visited,
    },
  };
});

const uniqueCountries = [
  ...new Map(
    countryFeatures.map((country) => [String(country.id), country]),
  ).values(),
];
const visitedCount = uniqueCountries.filter(
  (country) => country.properties.visited,
).length;
const notYetCount = uniqueCountries.length - visitedCount;
---

<section class="travel-map">
  <figure class="travel-map__container">
    <svg
      class="travel-map__svg"
      viewBox={`0 0 ${MAP_WIDTH} ${MAP_HEIGHT}`}
      role="img"
      aria-label={`World map of countries visited: ${visitedCount} visited, ${notYetCount} not yet`}
    >
      <defs>
        <pattern
          id="travel-dots"
          patternUnits="userSpaceOnUse"
          patternContentUnits="userSpaceOnUse"
          width="4"
          height="4"
        >
          <circle cx="1" cy="1" r="0.6" fill="var(--text)"></circle>
          <circle cx="3" cy="3" r="0.6" fill="var(--text)"></circle>
        </pattern>
      </defs>
      {
        countryFeatures.map((country) => (
          <path
            class="travel-map__country"
            d={path(country) ?? undefined}
            fill={
              country.properties.visited ? "var(--text)" : "url(#travel-dots)"
            }
            data-visited={country.properties.visited ? "true" : "false"}
            data-name={country.properties.name}
          />
        ))
      }
      <path class="travel-map__highlight" aria-hidden="true"></path>
    </svg>

    <figcaption class="travel-map__legend">
      <div class="travel-map__legend-item" data-type="visited">
        <div class="travel-map__legend-box travel-map__legend-box--visited">
        </div>
        <span class="travel-map__legend-count">{visitedCount}</span>
        <span class="travel-map__legend-label">Visited</span>
      </div>
      <div class="travel-map__legend-item" data-type="unvisited">
        <div class="travel-map__legend-box">
          <svg viewBox="0 0 18 18" aria-hidden="true">
            <defs>
              <pattern
                id="travel-dots-legend"
                patternUnits="userSpaceOnUse"
                width="6"
                height="6"
              >
                <circle cx="1.5" cy="1.5" r="1" fill="var(--text)"></circle>
                <circle cx="4.5" cy="4.5" r="1" fill="var(--text)"></circle>
              </pattern>
            </defs>
            <rect width="18" height="18" fill="url(#travel-dots-legend)"></rect>
          </svg>
        </div>
        <span class="travel-map__legend-count">{notYetCount}</span>
        <span class="travel-map__legend-label">Not yet</span>
      </div>
    </figcaption>

    <div class="travel-map__tooltip" aria-hidden="true">
      <strong class="travel-map__tooltip-name"></strong>
      <span class="travel-map__tooltip-status"></span>
    </div>
  </figure>
</section>

<script>
  const MAP_WIDTH = 960;
  let resizeHandler: (() => void) | null = null;
  let dismissHandler: ((event: MouseEvent) => void) | null = null;

  function setAttr(
    elements: Iterable<Element>,
    name: string,
    value: string | null,
  ) {
    for (const element of elements) {
      if (value === null) element.removeAttribute(name);
      else element.setAttribute(name, value);
    }
  }

  function initTravelMap() {
    const container = document.querySelector<HTMLElement>(
      ".travel-map__container",
    );
    if (!container) return;

    if (resizeHandler) {
      window.removeEventListener("resize", resizeHandler);
      resizeHandler = null;
    }
    if (dismissHandler) {
      document.removeEventListener("click", dismissHandler);
      dismissHandler = null;
    }

    const svg = container.querySelector<SVGSVGElement>(".travel-map__svg");
    const countries = container.querySelectorAll<SVGPathElement>(
      ".travel-map__country",
    );
    const highlight = container.querySelector<SVGPathElement>(
      ".travel-map__highlight",
    );
    const legendItems = document.querySelectorAll(".travel-map__legend-item");
    const tooltip = container.querySelector<HTMLElement>(
      ".travel-map__tooltip",
    );
    const tooltipName = container.querySelector<HTMLElement>(
      ".travel-map__tooltip-name",
    );
    const tooltipStatus = container.querySelector<HTMLElement>(
      ".travel-map__tooltip-status",
    );

    if (!svg || !highlight || !tooltip || !tooltipName || !tooltipStatus) {
      return;
    }

    const mapContainer = container;
    const mapSvg = svg;
    const mapHighlight = highlight;
    const mapTooltip = tooltip;
    const mapTooltipName = tooltipName;
    const mapTooltipStatus = tooltipStatus;

    function updatePatternScales() {
      const scale = mapSvg.getBoundingClientRect().width / MAP_WIDTH;
      for (const pattern of mapSvg.querySelectorAll("pattern")) {
        pattern.setAttribute("patternTransform", `scale(${1 / scale})`);
      }
    }

    function positionTooltip(event: MouseEvent) {
      const containerRect = mapContainer.getBoundingClientRect();
      const tooltipRect = mapTooltip.getBoundingClientRect();

      const containerX = event.clientX - containerRect.left;
      const containerY = event.clientY - containerRect.top;

      let left = containerX + 16;
      let top = containerY + 16;

      if (left + tooltipRect.width > containerRect.width) {
        left = containerRect.width - tooltipRect.width - 16;
      }
      if (left < 0) left = 16;
      if (top + tooltipRect.height > containerRect.height) {
        top = containerY - tooltipRect.height - 16;
      }
      if (top < 0) top = 16;

      mapTooltip.style.top = `${top}px`;
      mapTooltip.style.left = `${left}px`;
    }

    function showTooltip(country: SVGPathElement, event: MouseEvent) {
      mapTooltipName.textContent = country.getAttribute("data-name") ?? "";
      mapTooltipStatus.textContent =
        country.getAttribute("data-visited") === "true" ? "Visited" : "Not yet";
      mapHighlight.setAttribute("d", country.getAttribute("d") ?? "");
      mapTooltip.setAttribute("data-visible", "true");
      positionTooltip(event);
    }

    function hideTooltip() {
      mapHighlight.removeAttribute("d");
      mapTooltip.removeAttribute("data-visible");
    }

    resizeHandler = updatePatternScales;
    updatePatternScales();
    window.addEventListener("resize", resizeHandler);

    dismissHandler = (event) => {
      const target = event.target;
      if (target instanceof Element && target.closest(".travel-map__country")) {
        return;
      }
      hideTooltip();
    };
    document.addEventListener("click", dismissHandler);

    for (const country of countries) {
      country.addEventListener("mouseenter", (event) => {
        showTooltip(country, event as MouseEvent);
      });
      country.addEventListener("mousemove", (event) => {
        positionTooltip(event as MouseEvent);
      });
      country.addEventListener("mouseleave", hideTooltip);
      country.addEventListener("click", (event) => {
        showTooltip(country, event as MouseEvent);
      });
    }

    svg.addEventListener("mouseleave", hideTooltip);

    for (const item of legendItems) {
      item.addEventListener("mouseover", () => {
        const hoveredType = item.getAttribute("data-type");
        const isVisited = hoveredType === "visited";

        setAttr(countries, "data-dimmed", "true");

        for (const country of countries) {
          const visited = country.getAttribute("data-visited") === "true";
          if (visited === isVisited) {
            country.removeAttribute("data-dimmed");
            country.setAttribute("data-hovered", "true");
          }
        }

        for (const legendItem of legendItems) {
          if (legendItem.getAttribute("data-type") !== hoveredType) {
            legendItem.setAttribute("data-dimmed", "true");
          }
        }
      });

      item.addEventListener("mouseout", () => {
        setAttr(countries, "data-dimmed", null);
        setAttr(countries, "data-hovered", null);
        setAttr(legendItems, "data-dimmed", null);
      });
    }
  }

  document.addEventListener("astro:page-load", initTravelMap);
</script>

<style>
  .travel-map {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xl);
    margin-block-start: var(--space-3xl);
    width: 100vw;
    margin-inline: calc(50% - 50vw);
    padding-inline: var(--space-sm);
    box-sizing: border-box;
  }

  .travel-map__container {
    position: relative;
    width: 100%;
    max-width: 100%;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
  }

  .travel-map__svg {
    width: 100%;
    height: auto;
  }

  .travel-map__svg pattern {
    transform-origin: 0 0;
  }

  .travel-map__country {
    stroke: var(--background);
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
    cursor: default;
    transition: opacity var(--duration-normal) var(--ease-out);
  }

  .travel-map__country[data-hovered="true"] {
    stroke: var(--text);
    stroke-width: 2;
  }

  .travel-map__country[data-dimmed="true"] {
    opacity: 0.2;
  }

  .travel-map__highlight {
    fill: none;
    stroke: var(--text);
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2;
    vector-effect: non-scaling-stroke;
    pointer-events: none;
  }

  .travel-map__legend {
    width: 100%;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-xs);
    margin: 0;
    font-size: var(--fs-sm);
    white-space: nowrap;
  }

  .travel-map__legend-item {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    padding: var(--space-sm) var(--space-md);
    cursor: pointer;
    transition: opacity var(--duration-normal) var(--ease-out);
  }

  .travel-map__legend-item[data-dimmed="true"] {
    opacity: 0.3;
  }

  .travel-map__legend-count {
    font-weight: var(--fw-bold);
    color: var(--text);
  }

  .travel-map__legend-label {
    color: var(--text-subtle);
  }

  .travel-map__legend-box {
    flex-shrink: 0;
    width: 16px;
    height: 16px;
    border-radius: var(--radius-sm);
    overflow: hidden;
  }

  .travel-map__legend-box--visited {
    background: var(--text);
  }

  .travel-map__legend-box svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .travel-map__tooltip {
    position: absolute;
    white-space: nowrap;
    background: var(--text);
    color: var(--background);
    padding: var(--space-sm) var(--space-md);
    border-radius: var(--radius-sm);
    font-size: var(--fs-sm);
    line-height: var(--lh-snug);
    pointer-events: none;
    z-index: 10;
    visibility: hidden;
  }

  .travel-map__tooltip[data-visible="true"] {
    visibility: visible;
  }

  .travel-map__tooltip-name {
    display: block;
  }

  @media (min-width: 40rem) {
    .travel-map {
      padding-inline: var(--space-2xl);
    }

    .travel-map__container {
      max-width: 76rem;
    }
  }
</style>
