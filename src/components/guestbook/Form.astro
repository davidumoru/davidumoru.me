---
import "./postcard.css";

interface Props {
  countries: { country: string; hue: number }[];
}

const { countries } = Astro.props;
---

<form
  class="postcard postcard-form"
  method="POST"
  enctype="multipart/form-data"
>
  <div class="postcard-form-body">
    <label class="sr-only" for="content">Message</label>
    <textarea
      class="field field-message"
      name="content"
      id="content"
      required
      maxlength="150"
      placeholder="Leave a message, write a note, say hello..."></textarea>

    <label class="sr-only" for="author">Your name</label>
    <input
      class="field field-line"
      type="text"
      name="author"
      id="author"
      required
      maxlength="50"
      autocomplete="name"
      placeholder="Your name"
    />

    <label class="sr-only" for="link">Link</label>
    <input
      class="field field-line"
      type="url"
      name="link"
      id="link"
      autocomplete="url"
      placeholder="URL (optional)"
    />

    <label class="sr-only" for="country">Country</label>
    <select
      class="field field-line country-select"
      name="country"
      id="country"
      required
    >
      <option value="" disabled selected>Country</option>
      {
        countries.map(({ country, hue }) => (
          <option value={country} data-hue={hue}>
            {country}
          </option>
        ))
      }
    </select>

    <div class="combo" hidden>
      <label class="sr-only" for="country-input">Country</label>
      <input
        class="field field-line"
        type="text"
        id="country-input"
        role="combobox"
        aria-controls="combo-list"
        aria-expanded="false"
        aria-autocomplete="list"
        autocomplete="off"
        spellcheck="false"
        placeholder="Country"
      />
      <ul class="combo-list" id="combo-list" role="listbox" hidden>
        {
          countries.map(({ country, hue }, i) => (
            <li
              class="combo-option"
              id={`combo-opt-${i}`}
              role="option"
              aria-selected="false"
              data-value={country}
              data-hue={hue}
            >
              {country}
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="honeypot" aria-hidden="true">
    <label for="special">Leave this empty</label>
    <input
      type="text"
      id="special"
      name="special"
      tabindex="-1"
      autocomplete="off"
    />
  </div>

  <button class="post-mark" type="submit">Post it</button>

</form>

<style>
  .postcard-form {
    --rotate: -0.8deg;
    aspect-ratio: auto;
    overflow: visible;
    content-visibility: visible;
    display: inline-flex;
    flex-direction: column;
    padding: 1.5rem;
    text-align: left;
  }

  .postcard-form-body {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .field {
    width: 100%;
    box-sizing: border-box;
    border: none;
    background-color: transparent;
    color: var(--pc-ink);
    font-family: var(--font-geist-mono), ui-monospace, monospace;
    font-size: 0.95rem;
    transition: border-color var(--duration-fast, 150ms) ease;
  }
  .field::placeholder {
    color: oklch(0.28 0.02 65 / 0.42);
  }
  .field:focus {
    outline: none;
  }
  .field:focus-visible {
    outline: 2px solid var(--pc-ink);
    outline-offset: 3px;
  }

  .field:autofill,
  .field:-webkit-autofill,
  .field:-webkit-autofill:hover,
  .field:-webkit-autofill:focus,
  .field:-webkit-autofill:active {
    -webkit-text-fill-color: var(--pc-ink);
    caret-color: var(--pc-ink);
    box-shadow: 0 0 0 100px var(--pc-paper) inset;
    -webkit-box-shadow: 0 0 0 100px var(--pc-paper) inset;
    transition: background-color 6000s ease-in-out 0s;
  }

  .field-message {
    height: 7.5rem;
    padding: 0;
    resize: none;
    font-family: var(--font-mynerve), ui-rounded, cursive;
    font-size: 1.15rem;
    line-height: 1.45;
  }

  .field-line {
    padding: 0.4em 0;
    border-bottom: 1px dotted oklch(0.28 0.02 65 / 0.35);
  }
  .field-line:focus {
    border-bottom-style: solid;
    border-bottom-color: var(--pc-ink);
  }

  .country-select {
    appearance: none;
    cursor: pointer;
    color: var(--pc-ink);
  }
  .country-select:invalid {
    color: oklch(0.28 0.02 65 / 0.42);
  }

  .honeypot {
    display: none;
  }

  .combo {
    position: relative;
  }

  .combo-list {
    position: absolute;
    bottom: calc(100% + 4px);
    left: 0;
    right: 0;
    z-index: 6;
    max-height: 148px;
    overflow-y: auto;
    overscroll-behavior: contain;
    margin: 0;
    padding: 4px;
    list-style: none;
    border-radius: var(--radius-sm);
    background-color: var(--pc-paper);
    box-shadow:
      var(--shadow-border),
      0 6px 18px oklch(0 0 0 / 0.18);
    scrollbar-width: thin;
  }

  .combo-option {
    padding: 4px 7px;
    border-radius: var(--radius-xs);
    font-family: var(--font-geist-mono), ui-monospace, monospace;
    font-size: 0.8rem;
    color: var(--pc-ink);
    cursor: pointer;
  }

  .post-mark {
    position: absolute;
    right: 1.25rem;
    bottom: -0.85rem;
    z-index: 7;
    padding: 0.5rem 1rem;
    border: 1px solid var(--pc-ink);
    border-radius: var(--radius-xs);
    background-color: var(--pc-paper);
    color: var(--pc-ink);
    font-family: var(--font-geist-mono), ui-monospace, monospace;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    line-height: 1;
    cursor: pointer;
    rotate: -2.5deg;
    box-shadow:
      inset 0 0 0 2px var(--pc-paper),
      inset 0 0 0 3px oklch(0.28 0.02 65 / 0.55),
      0 2px 6px oklch(0 0 0 / 0.18);
    transition:
      rotate var(--duration-fast, 150ms) var(--ease-out, ease),
      background-color var(--duration-fast, 150ms) ease,
      color var(--duration-fast, 150ms) ease,
      box-shadow var(--duration-fast, 150ms) ease;
  }
  .post-mark:active {
    rotate: 0deg;
    background-color: var(--pc-ink);
    color: var(--pc-paper);
    box-shadow:
      inset 0 0 0 2px var(--pc-ink),
      inset 0 0 0 3px oklch(0.906 0.037 86 / 0.5),
      0 1px 2px oklch(0 0 0 / 0.2);
  }
  .post-mark:focus-visible {
    outline: 2px solid var(--pc-ink);
    outline-offset: 3px;
  }

  @media (hover: hover) and (pointer: fine) {
    .postcard-form:hover {
      transform: rotate(var(--rotate));
    }
    .combo-option:hover,
    .combo-option.is-active {
      background-color: oklch(0.28 0.02 65 / 0.08);
    }
    .post-mark:hover {
      rotate: 0deg;
      box-shadow:
        inset 0 0 0 2px var(--pc-paper),
        inset 0 0 0 3px var(--pc-ink),
        0 3px 10px oklch(0 0 0 / 0.22);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .post-mark,
    .post-mark:hover,
    .post-mark:active {
      transition: none;
      rotate: -2.5deg;
    }
  }
</style>

<script>
  let onDocumentClick: ((event: MouseEvent) => void) | null = null;

  function initFormStamp() {
    if (onDocumentClick) {
      document.removeEventListener("click", onDocumentClick);
      onDocumentClick = null;
    }

    const form = document.querySelector<HTMLFormElement>(".postcard-form");
    const select = form?.querySelector<HTMLSelectElement>(".country-select");
    if (!form || !select) return;

    const combo = form.querySelector<HTMLElement>(".combo");
    const input = form.querySelector<HTMLInputElement>("#country-input");
    const list = form.querySelector<HTMLElement>(".combo-list");
    if (!combo || !input || !list) return;

    combo.hidden = false;
    select.classList.add("sr-only");
    select.removeAttribute("required");

    const options = Array.from(
      list.querySelectorAll<HTMLLIElement>(".combo-option"),
    );
    const names = options.map((option) => option.dataset.value ?? "");
    let active: HTMLLIElement | null = null;

    const visible = () => options.filter((option) => !option.hidden);

    const setActive = (option: HTMLLIElement | null) => {
      active?.classList.remove("is-active");
      active = option;
      if (!option) {
        input.removeAttribute("aria-activedescendant");
        return;
      }
      option.classList.add("is-active");
      input.setAttribute("aria-activedescendant", option.id);
      option.scrollIntoView({ block: "nearest" });
    };

    const close = () => {
      list.hidden = true;
      input.setAttribute("aria-expanded", "false");
      setActive(null);
    };

    const open = () => {
      list.hidden = false;
      input.setAttribute("aria-expanded", "true");
    };

    const choose = (option: HTMLLIElement) => {
      const value = option.dataset.value ?? "";
      input.value = value;
      select.value = value;
      select.dispatchEvent(new Event("change", { bubbles: true }));
      input.setCustomValidity("");
      close();
    };

    const move = (step: number) => {
      const shown = visible();
      if (!shown.length) return;
      const index = active ? shown.indexOf(active) : -1;
      setActive(shown[(index + step + shown.length) % shown.length]);
    };

    input.addEventListener("input", () => {
      const needle = input.value.trim().toLowerCase();
      if (!needle) {
        close();
        return;
      }

      let shown = 0;
      options.forEach((option, i) => {
        const match = names[i].toLowerCase().includes(needle);
        option.hidden = !match;
        if (match) shown++;
      });

      if (shown) {
        open();
        setActive(visible()[0]);
      } else {
        close();
      }
    });

    input.addEventListener("keydown", (event) => {
      if (list.hidden && (event.key === "ArrowDown" || event.key === "ArrowUp"))
        return;

      switch (event.key) {
        case "ArrowDown":
          event.preventDefault();
          move(1);
          break;
        case "ArrowUp":
          event.preventDefault();
          move(-1);
          break;
        case "Enter":
          if (active) {
            event.preventDefault();
            choose(active);
          }
          break;
        case "Escape":
          close();
          break;
      }
    });

    input.addEventListener("blur", () => {
      window.setTimeout(() => {
        if (!list.hidden) return;
        const exact = names.find(
          (name) => name.toLowerCase() === input.value.trim().toLowerCase(),
        );
        if (exact) {
          select.value = exact;
          select.dispatchEvent(new Event("change", { bubbles: true }));
          input.value = exact;
        } else {
          input.value = select.value;
        }
      }, 120);
    });

    list.addEventListener("mousedown", (event) => {
      const option = (event.target as HTMLElement).closest<HTMLLIElement>(
        ".combo-option",
      );
      if (option) {
        event.preventDefault();
        choose(option);
      }
    });

    form.addEventListener("submit", (event) => {
      if (select.value) return;
      event.preventDefault();
      input.setCustomValidity("Pick a country from the list.");
      input.reportValidity();
    });
    input.addEventListener("input", () => input.setCustomValidity(""));

    onDocumentClick = (event: MouseEvent) => {
      if (!combo.contains(event.target as Node)) close();
    };
    document.addEventListener("click", onDocumentClick);
  }

  document.addEventListener("astro:page-load", initFormStamp);
</script>
