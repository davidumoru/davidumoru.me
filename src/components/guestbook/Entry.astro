---
import "./postcard.css";

interface Props {
  name: string;
  message: string;
  country: string;
  date: Date;
  imageUrl: string;
  no: number;
  link?: string | null;
  tilt?: number;
}

const {
  name,
  message,
  country,
  date,
  imageUrl,
  no,
  link,
  tilt = 0,
} = Astro.props;

const displayDate = date.toLocaleDateString("en-US", {
  month: "short",
  day: "numeric",
  year: "numeric",
});
---

<article class="postcard" style={`--rotate: ${tilt}deg`}>
  <img
    class="postcard-art"
    src={imageUrl}
    alt=""
    loading="lazy"
    decoding="async"
    fetchpriority="low"
    width="1200"
    height="896"
  />

  <div class="postcard-body">
    <p class="postcard-message">{message}</p>
    <p class="postcard-signature">
      {
        link ? (
          <a
            class="postcard-sign"
            href={link}
            target="_blank"
            rel="noopener noreferrer"
          >
            {name}
          </a>
        ) : (
          <span class="postcard-sign">{name}</span>
        )
      }
    </p>
  </div>

  <footer class="postcard-info">
    <span class="postcard-place">{country}</span>
    <time datetime={date.toISOString()}>{displayDate}</time>
    <span>No. {String(no).padStart(3, "0")}</span>
  </footer>
</article>
