---
interface Props {
  type: "success" | "error";
  message: string;
}

const { type, message } = Astro.props;
const mark = type === "success" ? "Posted" : "Return to sender";
---

<div class="alert" data-type={type} role="alert">
  <span class="alert-mark">{mark}</span>
  <p class="alert-message">{message}</p>
  <button class="alert-dismiss" type="button" aria-label="Dismiss this message"
    >&times;</button
  >
</div>

<style>
  .alert {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
    margin-bottom: 1.5rem;
    padding: 0.55rem 0.6rem;
    border-radius: var(--radius-xs);
    background-color: var(--pc-paper);
    color: var(--alert-ink);
    font-family: var(--font-geist-mono), ui-monospace, monospace;
    rotate: -0.4deg;
    box-shadow:
      inset 0 0 0 1px var(--alert-ink),
      inset 0 0 0 2px var(--pc-paper),
      inset 0 0 0 3px var(--alert-ink-soft),
      0 2px 8px oklch(0 0 0 / 0.14);
  }

  .alert[data-type="success"] {
    --alert-ink: oklch(0.42 0.09 150);
    --alert-ink-soft: oklch(0.42 0.09 150 / 0.4);
  }

  .alert[data-type="error"] {
    --alert-ink: oklch(0.45 0.14 35);
    --alert-ink-soft: oklch(0.45 0.14 35 / 0.4);
  }

  .alert-mark {
    flex: none;
    padding: 0.32rem 0.55rem;
    border: 1px solid var(--alert-ink);
    border-radius: var(--radius-xs);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    line-height: 1;
    rotate: -1.5deg;
  }

  .alert-message {
    flex: 1;
    min-width: 0;
    margin: 0;
    font-size: 0.85rem;
    line-height: 1.45;
  }

  .alert-dismiss {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    padding: 0;
    border: none;
    border-radius: var(--radius-xs);
    background: transparent;
    color: inherit;
    font-family: inherit;
    font-size: 1.1rem;
    line-height: 1;
    opacity: 0.55;
    cursor: pointer;
    transition:
      opacity var(--duration-fast) var(--ease-out),
      background var(--duration-fast) var(--ease-out);
  }
  .alert-dismiss:focus-visible {
    opacity: 1;
    outline: 2px solid currentColor;
    outline-offset: 1px;
  }

  @media (hover: hover) and (pointer: fine) {
    .alert-dismiss:hover {
      opacity: 1;
      background: oklch(0 0 0 / 0.07);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .alert-dismiss {
      transition: none;
    }
  }
</style>

<script>
  function initAlerts() {
    for (const button of document.querySelectorAll<HTMLButtonElement>(
      ".alert .alert-dismiss",
    )) {
      button.addEventListener("click", () =>
        button.closest(".alert")?.remove(),
      );
    }
  }

  document.addEventListener("astro:page-load", initAlerts);
</script>
