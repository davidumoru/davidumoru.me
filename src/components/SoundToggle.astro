---
import { Icon } from "./ui/Icon/Icon.tsx";
---

<button
  id="soundToggle"
  class="sound-toggle"
  type="button"
  aria-pressed="false"
  aria-label="Toggle interface sound"
  data-silent
>
  <span class="when-on"
    ><Icon name="speakerSimpleHigh" size={16} variant="duotone" /></span
  >
  <span class="when-off"
    ><Icon name="speakerSimpleSlash" size={16} variant="duotone" /></span
  >
</button>

<script>
  import { play, isEnabled, toggle, prime } from "../utils/sound";

  if (!(window as any).__soundUnlockBound) {
    (window as any).__soundUnlockBound = true;
    const unlock = () => {
      prime();
      window.removeEventListener("pointerdown", unlock, true);
      window.removeEventListener("keydown", unlock, true);
    };
    window.addEventListener("pointerdown", unlock, true);
    window.addEventListener("keydown", unlock, true);
  }

  const INTERACTIVE = "a[href], button, [role='button'], summary";
  const HOVERABLE = "a[href]";

  if (!(window as any).__soundClickBound) {
    (window as any).__soundClickBound = true;
    document.addEventListener("click", (event) => {
      const el = (event.target as HTMLElement).closest<HTMLElement>(
        INTERACTIVE,
      );
      if (!el || el.closest("[data-silent]")) return;
      play(el.dataset.sound || "click");
    });
  }

  if (!(window as any).__soundHoverBound) {
    (window as any).__soundHoverBound = true;
    let current: HTMLElement | null = null;
    document.addEventListener("mouseover", (event) => {
      const el = (event.target as HTMLElement).closest<HTMLElement>(HOVERABLE);
      if (el === current) return;
      current = el;
      if (!el || el.closest("[data-silent]")) return;
      play(el.dataset.hoverSound || "hover");
    });
  }

  function setupToggle() {
    const btn = document.getElementById("soundToggle");
    if (!btn || btn.dataset.ready) return;
    btn.dataset.ready = "true";
    btn.setAttribute("aria-pressed", String(isEnabled()));
    btn.addEventListener("click", () => {
      btn.setAttribute("aria-pressed", String(toggle()));
    });
  }

  setupToggle();
  document.addEventListener("astro:page-load", setupToggle);
</script>

<style>
  .sound-toggle {
    display: none;
    place-items: center;
    inline-size: 2.25rem;
    block-size: 2.25rem;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: var(--surface);
    box-shadow: var(--shadow-border);
    color: var(--text-subtle);
    cursor: pointer;
    opacity: 0.55;
    transition:
      opacity var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out);
  }
  .sound-toggle:hover {
    opacity: 1;
    color: var(--text);
    box-shadow: var(--shadow-border-hover);
  }
  .sound-toggle:focus-visible {
    opacity: 1;
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }
  .when-on,
  .when-off {
    grid-area: 1 / 1;
    display: inline-flex;
    transition:
      opacity var(--duration-normal) var(--ease-out),
      scale var(--duration-normal) var(--ease-out);
  }
  .when-on {
    opacity: 0;
    scale: 0.5;
  }
  .when-off {
    opacity: 1;
    scale: 1;
  }
  .sound-toggle[aria-pressed="true"] .when-on {
    opacity: 1;
    scale: 1;
  }
  .sound-toggle[aria-pressed="true"] .when-off {
    opacity: 0;
    scale: 0.5;
  }
  @media (hover: hover) and (pointer: fine) {
    .sound-toggle {
      display: inline-grid;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .sound-toggle {
      transition: none;
    }
  }
</style>
