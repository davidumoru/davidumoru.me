# Turso Database Credentials
# Get these from the https://app.turso.tech
ASTRO_DB_REMOTE_URL=
ASTRO_DB_APP_TOKEN=

# Spotify API Credentials
# Get these from https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Vercel KV Credentials (optional for local dev, but recommended)
# Get these from the Vercel Dashboard -> Storage -> KV
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# Cloudflare Turnstile (guestbook spam protection)
# Create a widget at https://dash.cloudflare.com -> Turnstile
# For local dev you can use Cloudflare's always-pass test keys:
#   TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
